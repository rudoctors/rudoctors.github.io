{
  "name": "d-projects-rudoctors-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:relay": "deno check --no-config --sloppy-imports deno/doctor-relay.ts deno/review-intake.ts",
    "check:review": "deno test --allow-read --no-config --sloppy-imports deno/review-flow.test.ts",
    "lint": "astro check",
    "seed": "node scripts/seed.mjs",
    "tg:bot": "node scripts/telegram-bot.mjs",
    "fetch:sheet": "node scripts/fetch-sheet.mjs",
    "fetch:citilab": "node scripts/fetch-citilab.mjs",
    "fetch:tg": "node scripts/fetch-tg.mjs",
    "fetch:tg-export": "node --max-old-space-size=4096 scripts/preprocess-tg-export.mjs",
    "import:tg": "node scripts/import-tg-cards.mjs",
    "import:tg:write": "node scripts/import-tg-cards.mjs --write",
    "fetch:raw": "node scripts/fetch-raw.mjs",
    "fetch:alfa": "node scripts/scrape-alfa.mjs",
    "fetch:medigroup": "node scripts/scrape-medigroup.mjs",
    "fetch:doctorus": "node scripts/scrape-doctorus.mjs",
    "fetch:stetoskop": "node scripts/scrape-stetoskop.mjs",
    "fetch:hipokratija": "node scripts/scrape-hipokratija.mjs",
    "fetch:ocenilekara": "node scripts/scrape-ocenilekara.mjs",
    "fetch:lks": "python scripts/scrape-lks-licenses.py",
    "fetch:biramdoktora": "node scripts/scrape-biramdoktora.mjs",
    "fetch:nadjidoktora": "node scripts/scrape-nadjidoktora.mjs",
    "fetch:ordinacije": "node scripts/scrape-ordinacije.mjs",
    "fetch:serbian": "python scripts/scrape-lks-licenses.py && node scripts/scrape-stetoskop.mjs && node scripts/scrape-biramdoktora.mjs && node scripts/scrape-nadjidoktora.mjs && node scripts/scrape-ordinacije.mjs && node scripts/scrape-hipokratija.mjs && node scripts/scrape-ocenilekara.mjs",
    "dedup:serbian": "node scripts/dedup-serbian-doctors.mjs",
    "dedup:serbian:write": "node scripts/dedup-serbian-doctors.mjs --write",
    "fetch:clinics": "node scripts/fetch-citilab.mjs && node scripts/scrape-alfa.mjs && node scripts/scrape-medigroup.mjs && node scripts/scrape-doctorus.mjs",
    "fetch:all": "node scripts/fetch-sheet.mjs && node scripts/fetch-citilab.mjs && node scripts/fetch-tg.mjs && node scripts/seed.mjs",
    "merge:duplicates": "node scripts/merge-duplicates.mjs",
    "merge:dups2": "node scripts/merge-dups-phase2.mjs",
    "tag:en": "node scripts/tag-en-reviews.mjs",
    "translate": "node scripts/translate-reviews.mjs",
    "detect:dups": "node scripts/detect-dups.mjs",
    "audit:clinics": "node scripts/clinics-audit.mjs",
    "photos:webp": "node scripts/convert-photos-webp.mjs",
    "refresh": "node scripts/fetch-sheet.mjs && node scripts/fetch-citilab.mjs && node scripts/seed.mjs && node scripts/tag-en-reviews.mjs && npm run check",
    "indexnow": "node scripts/indexnow.mjs",
    "test:audit": "node scripts/validate-build.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
