---
import Layout from "../../layouts/Layout.astro";
import DoctorCard from "../../components/DoctorCard.astro";
import { allCities, publicDoctors, specLabel } from "../../lib/doctors";
import { citySlug, cityLabel, SITE, SCHEMA_IDS } from "../../lib/site";
import cityIntros from "../../data/city-intros.json";

export function getStaticPaths() {
  return allCities().map((city) => ({
    params: { city: citySlug(city) },
    props: { city },
  }));
}

interface Props {
  city: string;
}

const { city } = Astro.props;
const cityRu = cityLabel(city);
const doctors = publicDoctors().filter((d) => d.city === city);
const specCounts = [...new Set(doctors.flatMap((d) => d.specializations))]
  .map((k) => ({ k, label: specLabel(k), n: doctors.filter((d) => d.specializations.includes(k)).length }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 8);
const introsMap = cityIntros as Record<string, string>;
const intro =
  introsMap[city] ||
  `Русскоязычные врачи в ${cityRu}, Сербия: рейтинги, отзывы пациентов, специализации и контакты. ${doctors.length} карточек в каталоге Rudoctors.`;
const cityPath = `/cities/${citySlug(city)}/`;
---

<Layout
  title={`Русскоязычные врачи в ${cityRu} (Сербия) — ${doctors.length} специалистов, проверенные отзывы и контакты | RuDoctors`}
  description={`Поиск проверенных русскоязычных врачей и частных клиник в г. ${cityRu}, Сербия (${doctors.length} специалистов): стоматологи, педиатры, терапевты, гинекологи. Реальные отзывы пациентов, адреса и прямые контакты.`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Русскоязычные врачи в ${cityRu}, Сербия — каталог клиник и отзывы`,
    url: `${SITE.url}${cityPath}`,
    description: `Поиск проверенных русскоязычных врачей и частных клиник в г. ${cityRu}, Сербия (${doctors.length} специалистов): рейтинги, отзывы, специальности и прямые контакты.`,
    isPartOf: { "@id": SCHEMA_IDS.website },
    about: {
      "@type": "City",
      name: cityRu,
      containedInPlace: { "@type": "Country", name: "Сербия" },
    },
  }}
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Города", path: "/cities/" },
    { name: cityRu, path: cityPath },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/cities/" class="hover:text-brand-700">Города</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800">{cityRu}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-extrabold text-navy-900">Врачи в {cityRu}</h1>
    <p class="mt-2 text-slate-600">{doctors.length} карточек в каталоге</p>
    <div class="mt-4 max-w-3xl text-slate-700 leading-relaxed">
      <p>{intro}</p>
    </div>

    {
      specCounts.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2 items-center">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide mr-1">Популярное:</span>
          {specCounts.map((s) => (
            <a href={`/specialties/${s.k}/`} class="chip hover:bg-brand-100">
              {s.label} · {s.n}
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <a href={`/doctors/?city=${city}`} class="chip bg-brand-50 text-brand-700 font-semibold ring-1 ring-brand-600/20">
        Все в г. {cityRu} ({doctors.length})
      </a>
      {doctors.some((d) => d.origin === "rs") && (
        <a href={`/doctors/?city=${city}&origin=rs`} class="chip bg-rose-50 text-rose-700 hover:bg-rose-100 font-semibold ring-1 ring-rose-600/20 flex items-center gap-1 transition">
          <span aria-hidden="true">🇷🇸</span>
          <span>Сербские врачи ({doctors.filter((d) => d.origin === "rs").length})</span>
        </a>
      )}
      {doctors.some((d) => d.origin !== "rs") && (
        <a href={`/doctors/?city=${city}&origin=ru`} class="chip hover:bg-slate-200 transition">
          Русскоязычные врачи ({doctors.filter((d) => d.origin !== "rs").length})
        </a>
      )}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {doctors.map((d) => <DoctorCard doctor={d} />)}
    </div>
  </div>
</Layout>
