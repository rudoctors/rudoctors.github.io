---
import Layout from "../../../layouts/Layout.astro";
import DoctorCard from "../../../components/DoctorCard.astro";
import { publicDoctors, specLabel } from "../../../lib/doctors";
import { citySlug, cityLabel, SITE, SCHEMA_IDS, plural } from "../../../lib/site";
import { getClusterData } from "../../../lib/clusters";

export function getStaticPaths() {
  const doctors = publicDoctors();
  const pairs = new Map<string, { city: string; citySlug: string; specialty: string }>();

  for (const doc of doctors) {
    if (!doc.city) continue;
    const cSlug = citySlug(doc.city);
    for (const s of doc.specializations) {
      if (!s || !s.trim()) continue;
      const cleanSpec = s.trim();
      const pairKey = `${cSlug}::${cleanSpec}`;
      if (!pairs.has(pairKey)) {
        pairs.set(pairKey, {
          city: doc.city,
          citySlug: cSlug,
          specialty: cleanSpec,
        });
      }
    }
  }

  return Array.from(pairs.values()).map((p) => ({
    params: { city: p.citySlug, specialty: p.specialty },
    props: { city: p.city, specialty: p.specialty },
  }));
}

interface Props {
  city: string;
  specialty: string;
}

const { city, specialty } = Astro.props;
const cityRu = cityLabel(city);
const cSlug = citySlug(city);
const specName = specLabel(specialty);

const allCityDocs = publicDoctors().filter((d) => d.city === city);
const doctors = allCityDocs.filter((d) => d.specializations.includes(specialty));
const serbianCount = doctors.filter((d) => d.origin === "rs").length;
const russianCount = doctors.filter((d) => d.origin !== "rs").length;

const PAGE_SIZE = 24;
const visibleDoctors = doctors.slice(0, PAGE_SIZE);
const hasMore = doctors.length > PAGE_SIZE;

const cluster = getClusterData(cSlug, specialty);

// Другие популярные специальности в этом городе
const otherSpecs = [...new Set(allCityDocs.flatMap((d) => d.specializations))]
  .filter((s) => s !== specialty)
  .map((s) => ({
    k: s,
    label: specLabel(s),
    n: allCityDocs.filter((d) => d.specializations.includes(s)).length,
  }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 6);

const pageCanonical = `${SITE.url}/cities/${cSlug}/${specialty}/`;
const pageTitle = cluster
  ? `${cluster.h1} | RuDoctors`
  : `${specName} в ${cityRu} (Сербия) — ${doctors.length} ${plural(doctors.length, "врач", "врача", "врачей")}, отзывы и запись | RuDoctors`;

const pageDesc = cluster
  ? `${cluster.subtitle}. В каталоге ${doctors.length} проверенных врачей (${russianCount} русскоязычных, ${serbianCount} сербских с лицензией LKS). Реальные отзывы, адреса и прямые контакты.`
  : `Поиск проверенных специалистов «${specName}» в г. ${cityRu}, Сербия (${doctors.length} ${plural(doctors.length, "врач", "врача", "врачей")}): контакты, отзывы пациентов, клиники и запись.`;

// Schema.org structured data
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "@id": `${pageCanonical}#webpage`,
    name: cluster?.h1 || `${specName} в г. ${cityRu}, Сербия`,
    url: pageCanonical,
    description: pageDesc,
    inLanguage: "ru",
    isPartOf: { "@id": SCHEMA_IDS.website },
    about: [
      {
        "@type": "MedicalSpecialty",
        name: specName,
      },
      {
        "@type": "City",
        name: cityRu,
        containedInPlace: { "@type": "Country", name: "Сербия" },
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageCanonical}#collection`,
    url: pageCanonical,
    name: `${specName} в ${cityRu} — проверенные специалисты`,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: doctors.length,
      itemListElement: doctors.slice(0, 30).map((d, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        url: `${SITE.url}/doctors/${d.slug}/`,
        name: d.name,
      })),
    },
  },
];

if (cluster?.faq && cluster.faq.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageCanonical}#faq`,
    mainEntity: cluster.faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  });
}
---

<Layout
  title={pageTitle}
  description={pageDesc}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Города", path: "/cities/" },
    { name: cityRu, path: `/cities/${cSlug}/` },
    { name: specName, path: `/cities/${cSlug}/${specialty}/` },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-slate-500 mb-6 flex flex-wrap gap-2 items-center" aria-label="Хлебные крошки">
      <a href="/" class="hover:text-brand-700">Главная</a>
      <span>/</span>
      <a href="/cities/" class="hover:text-brand-700">Города</a>
      <span>/</span>
      <a href={`/cities/${cSlug}/`} class="hover:text-brand-700">{cityRu}</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{specName}</span>
    </nav>

    <!-- Hero Header -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-50 text-brand-700 ring-1 ring-brand-600/20">
          📍 {cityRu}
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
          {specName}
        </span>
        {cluster && (
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 ring-1 ring-amber-600/20 flex items-center gap-1">
            <span>🔥</span>
            <span>Горячий спрос</span>
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-navy-900 leading-tight">
        {cluster ? cluster.h1 : `${specName} в ${cityRu}`}
      </h1>

      <p class="mt-3 text-base md:text-lg text-slate-600 leading-relaxed max-w-4xl">
        {cluster
          ? cluster.subtitle
          : `В каталоге RuDoctors собраны проверенные русскоязычные и национальные сербские специалисты по направлению «${specName}» в городе ${cityRu}.`}
      </p>

      {cluster?.intro && (
        <div class="mt-4 p-4 rounded-xl bg-slate-50 border border-slate-200/80 text-sm text-slate-700 leading-relaxed max-w-4xl">
          <p>{cluster.intro}</p>
        </div>
      )}
    </header>

    <!-- Urgency Banner (если горячий кластер) -->
    {cluster?.urgencyBanner && (
      <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-rose-50 to-amber-50 border border-rose-200/80 shadow-xs">
        <div class="flex flex-col sm:flex-row items-start gap-3">
          <div class="text-2xl shrink-0">🚨</div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-rose-950">
              {cluster.urgencyBanner.title}
            </h2>
            <p class="mt-1 text-sm text-slate-700 leading-relaxed">
              {cluster.urgencyBanner.text}
            </p>
          </div>
        </div>
      </div>
    )}

    <!-- Emergency / Urgent Facilities (Дежурные стационары, CBCT, лаборатории) -->
    {cluster?.emergencyFacilities && cluster.emergencyFacilities.length > 0 && (
      <section class="mb-10" aria-labelledby="emergency-heading">
        <div class="flex items-center justify-between mb-4">
          <h2 id="emergency-heading" class="text-xl sm:text-2xl font-bold text-navy-900 flex items-center gap-2">
            <span>🏥</span>
            <span>Дежурные стационары и экстренная диагностика</span>
          </h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {cluster.emergencyFacilities.map((fac) => (
            <div class="card p-5 flex flex-col justify-between border-l-4 border-l-brand-600">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-slate-700">
                    {fac.hours}
                  </span>
                  <div class="flex gap-1">
                    {fac.tags.map((t) => (
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-brand-50 text-brand-700">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
                <h3 class="font-bold text-navy-900 text-base leading-snug">
                  {fac.name}
                </h3>
                {fac.nameSr && (
                  <p class="text-xs text-slate-500 mt-0.5 italic">{fac.nameSr}</p>
                )}
                <p class="text-xs text-slate-600 mt-2 flex items-start gap-1">
                  <span class="shrink-0 text-slate-400">📍</span>
                  <span>{fac.address}</span>
                </p>
                <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                  {fac.note}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <a
                  href={`tel:${fac.phoneRaw}`}
                  class="btn-primary !py-1.5 !px-3 text-xs flex items-center gap-1.5 font-bold"
                  aria-label={`Позвонить: ${fac.name}`}
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>{fac.phone}</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Price Benchmark Card (Ориентировочные цены) -->
    {cluster?.prices && cluster.prices.length > 0 && (
      <section class="mb-10" aria-labelledby="prices-heading">
        <div class="card p-5 sm:p-6 bg-gradient-to-br from-slate-50 to-white">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
              <h2 id="prices-heading" class="text-lg sm:text-xl font-bold text-navy-900 flex items-center gap-2">
                <span>💶</span>
                <span>Ориентировочные цены на услуги в {cityRu} (2026)</span>
              </h2>
              <p class="text-xs text-slate-500 mt-1">
                Средняя стоимость в частных клиниках и ординациях города на основе анализа прайс-листов
              </p>
            </div>
            <span class="text-xs text-slate-400 shrink-0 self-start sm:self-center">
              Курс: ~117 RSD = 1 EUR
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                  <th class="py-2.5 px-3">Медицинская услуга / процедура</th>
                  <th class="py-2.5 px-3">Цена (RSD)</th>
                  <th class="py-2.5 px-3">В евро (EUR)</th>
                  <th class="py-2.5 px-3 hidden sm:table-cell">Примечание</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700">
                {cluster.prices.map((p) => (
                  <tr class="hover:bg-slate-50/80 transition">
                    <td class="py-2.5 px-3 font-medium text-navy-900">
                      {p.service}
                    </td>
                    <td class="py-2.5 px-3 font-semibold text-brand-700 whitespace-nowrap">
                      {p.rsd}
                    </td>
                    <td class="py-2.5 px-3 text-slate-600 whitespace-nowrap">
                      {p.eur}
                    </td>
                    <td class="py-2.5 px-3 text-xs text-slate-500 hidden sm:table-cell">
                      {p.note || "—"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )}

    <!-- Filter and Doctors Section -->
    <section class="mb-12" aria-labelledby="doctors-heading">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 id="doctors-heading" class="text-xl sm:text-2xl font-bold text-navy-900">
            Специалисты в каталоге ({doctors.length})
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
            Сортировка по верификации, рейтингу и наличию отзывов
          </p>
        </div>

        <div class="flex flex-wrap gap-2 text-xs">
          <a
            href={`/doctors/?city=${city}&spec=${specialty}`}
            class="chip bg-brand-50 text-brand-700 font-semibold ring-1 ring-brand-600/20 hover:bg-brand-100"
          >
            Все специалисты ({doctors.length})
          </a>
          {serbianCount > 0 && (
            <a
              href={`/doctors/?city=${city}&spec=${specialty}&origin=rs`}
              class="chip bg-rose-50 text-rose-700 hover:bg-rose-100 font-semibold ring-1 ring-rose-600/20 flex items-center gap-1 transition"
            >
              <span aria-hidden="true">🇷🇸</span>
              <span>Сербские врачи ({serbianCount})</span>
            </a>
          )}
          {russianCount > 0 && (
            <a
              href={`/doctors/?city=${city}&spec=${specialty}&origin=ru`}
              class="chip hover:bg-slate-200 transition"
            >
              Русскоязычные врачи ({russianCount})
            </a>
          )}
        </div>
      </div>

      <!-- Doctors Grid -->
      {visibleDoctors.length > 0 ? (
        <>
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {visibleDoctors.map((d, index) => (
              <DoctorCard doctor={d} priority={index < 3} />
            ))}
          </div>

          {hasMore && (
            <div class="mt-8 p-6 rounded-2xl bg-slate-50 border border-slate-200 text-center">
              <p class="text-sm text-slate-600 mb-3">
                Показаны первые {PAGE_SIZE} специалистов из {doctors.length} в г. {cityRu}.
              </p>
              <a
                href={`/doctors/?city=${city}&spec=${specialty}`}
                class="btn-primary inline-flex items-center gap-2"
              >
                <span>Смотреть всех специалистов ({doctors.length}) в каталоге с фильтрами</span>
                <span>→</span>
              </a>
            </div>
          )}
        </>
      ) : (
        <div class="card p-10 text-center text-slate-500">
          <p class="text-base font-medium">В этой специальности в г. {cityRu} пока нет активных карточек врачей.</p>
          <p class="text-sm mt-2">
            Если вы практикующий специалист или клиника,
            <a href="/add-doctor/" class="text-brand-700 font-semibold hover:underline ml-1">добавьте профиль в каталог</a>.
          </p>
        </div>
      )}
    </section>

    <!-- FAQ Section (для горячих кластеров) -->
    {cluster?.faq && cluster.faq.length > 0 && (
      <section class="mb-12" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-xl sm:text-2xl font-bold text-navy-900 mb-4 flex items-center gap-2">
          <span>❓</span>
          <span>Частые вопросы экспатов: {specName.toLowerCase()} в г. {cityRu}</span>
        </h2>
        <div class="space-y-3">
          {cluster.faq.map((item) => (
            <details class="card p-5 group open:bg-slate-50 transition cursor-pointer">
              <summary class="font-bold text-navy-900 flex items-center justify-between gap-4 list-none">
                <span>{item.q}</span>
                <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-3 text-sm text-slate-700 leading-relaxed border-t border-slate-100 pt-3">
                {item.a}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Guides & Fast Interlinking -->
    {cluster?.relatedGuides && cluster.relatedGuides.length > 0 && (
      <section class="mb-10" aria-labelledby="guides-heading">
        <h2 id="guides-heading" class="text-lg sm:text-xl font-bold text-navy-900 mb-4 flex items-center gap-2">
          <span>📖</span>
          <span>Полезные руководства и инструкции</span>
        </h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {cluster.relatedGuides.map((guide) => (
            <a href={guide.href} class="card p-4 hover:border-brand-300 hover:shadow-sm transition flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-navy-900 text-sm hover:text-brand-700 transition">
                  {guide.title} →
                </h3>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                  {guide.desc}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Other Popular Specialties in City (Pillar-Cluster interlinking) -->
    {otherSpecs.length > 0 && (
      <section class="pt-8 border-t border-slate-200">
        <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-3">
          Другие медицинские направления в г. {cityRu}:
        </h3>
        <div class="flex flex-wrap gap-2">
          {otherSpecs.map((s) => (
            <a
              href={`/cities/${cSlug}/${s.k}/`}
              class="chip hover:bg-brand-50 hover:text-brand-700 hover:border-brand-200 transition text-xs"
            >
              {s.label} ({s.n})
            </a>
          ))}
          <a
            href={`/cities/${cSlug}/`}
            class="chip bg-slate-100 text-slate-700 font-medium hover:bg-slate-200 transition text-xs"
          >
            Все врачи в {cityRu} →
          </a>
        </div>
      </section>
    )}
  </div>
</Layout>
