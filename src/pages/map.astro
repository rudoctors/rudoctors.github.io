---
import Layout from "../layouts/Layout.astro";
import ClinicsMap from "../components/ClinicsMap.astro";
import { SITE, SCHEMA_IDS } from "../lib/site";

const mapUrl = `${SITE.url}/map/`;
---

<Layout
  title="Интерактивная карта медицинских клиник Сербии — адреса, больницы 24/7 и врачи"
  description="Интерактивная карта проверенных медицинских центров, стоматологий, лабораторий и круглосуточных стационаров 24/7 в Белграде, Нови-Саде и Нише с контактами и врачами каталога RuDoctors."
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Карта клиник", path: "/map/" },
  ]}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Интерактивная карта медицинских клиник Сербии",
    url: mapUrl,
    description:
      "Карта клиник, стоматологий, лабораторий и стационаров в Белграде, Нови-Саде и других городах Сербии.",
    isPartOf: { "@id": SCHEMA_IDS.website },
    about: {
      "@type": "MedicalOrganization",
      name: "Клиники и медицинские центры Сербии",
      areaServed: { "@type": "Country", name: "Сербия" },
    },
  }}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-slate-500 mb-6" aria-label="Хлебные крошки">
      <a href="/" class="hover:text-brand-700">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 font-medium">Карта клиник</span>
    </nav>

    <!-- Hero Header -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold mb-3 border border-brand-100">
        <span>🗺️</span>
        <span>Интерактивный справочник медицины</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-navy-900 tracking-tight">
        Медицинские клиники Сербии на карте
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-3xl leading-relaxed">
        Находите проверенные клиники, стоматологии, лаборатории анализов и круглосуточные стационары 24/7 в Белграде, Нови-Саде и Нише. Точные адреса, районы, маршруты проезда и прямая связь со специалистами из каталога RuDoctors.
      </p>
    </div>

    <!-- Interactive Map Component -->
    <ClinicsMap />

    <!-- Explanatory Guide Section -->
    <div class="mt-12 pt-8 border-t border-slate-200 grid gap-6 sm:grid-cols-3 text-sm">
      <div class="card p-5">
        <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-lg mb-3">
          🏥
        </div>
        <h3 class="font-bold text-slate-900 text-base">Цветовая классификация</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Каждое учреждение на карте обозначено своим цветом: <strong class="text-blue-600">синий</strong> — многопрофильные медцентры (MediGroup, Euromedic, Bel Medic), <strong class="text-emerald-600">зеленый</strong> — стоматологии, <strong class="text-orange-600">оранжевый</strong> — лаборатории анализов, <strong class="text-purple-600">фиолетовый</strong> — ординации, <strong class="text-rose-600">красный</strong> — стационары 24/7.
        </p>
      </div>

      <div class="card p-5">
        <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center text-lg mb-3">
          🚨
        </div>
        <h3 class="font-bold text-slate-900 text-base">Экстренная помощь 24/7</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          В случае острой необходимости на карте выделены национальные центры неотложной помощи с круглосуточным приёмом: Военно-медицинская академия (ВМА) и Клинический центр Сербии (UKCS / Ургентный центр).
        </p>
      </div>

      <div class="card p-5">
        <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-lg mb-3">
          👨‍⚕️
        </div>
        <h3 class="font-bold text-slate-900 text-base">Принимающие врачи</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          В карточке филиала на карте вы сразу видите русскоязычных врачей каталога RuDoctors, принимающих в этой клинике. Кликайте на карточку врача для перехода к отзывам, квалификации и записи.
        </p>
      </div>
    </div>
  </div>
</Layout>
