---
import Layout from "../layouts/Layout.astro";
import ClinicsMap from "../components/ClinicsMap.astro";
import { SITE, SCHEMA_IDS } from "../lib/site";

const mapUrl = `${SITE.url}/map/`;
---

<Layout
  title="Интерактивная карта клиник и дежурных аптек Сербии — поиск «Где я», больницы 24/7 и Дом здравља"
  description="Интерактивная карта медицинских учреждений и дежурных аптек 24/7 Сербии: поиск ближайших клиник «Где я», районные поликлиники (Дом здравља), круглосуточные больницы, ночные аптеки Белграда, Нови-Сада и Ниша, частные медцентры и врачи RuDoctors."
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Карта клиник и аптек", path: "/map/" },
  ]}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Интерактивная карта медицинских клиник, дежурных аптек и Домов здравля Сербии",
    url: mapUrl,
    description:
      "Карта клиник, дежурных аптек 24/7, районных поликлиник (Дом здравља), стоматологий, лабораторий и стационаров 24/7 в Белграде, Нови-Саде и Сербии.",
    isPartOf: { "@id": SCHEMA_IDS.website },
    about: {
      "@type": "MedicalOrganization",
      name: "Клиники, дежурные аптеки 24/7, поликлиники и больницы Сербии",
      areaServed: { "@type": "Country", name: "Сербия" },
    },
  }}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-slate-500 mb-6" aria-label="Хлебные крошки">
      <a href="/" class="hover:text-brand-700">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 font-medium">Карта клиник и аптек</span>
    </nav>

    <!-- Hero Header -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold mb-3 border border-brand-100">
        <span>🗺️</span>
        <span>Интерактивный медицинский навигатор по Сербии</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-navy-900 tracking-tight">
        Медицинские клиники и дежурные аптеки Сербии на карте
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-3xl leading-relaxed">
        Районные поликлиники (Дом здравља), дежурные ночные аптеки 24/7, круглосуточные стационары, детские неотложки, роддома и частные медицинские центры Белграда, Нови-Сада и Ниша с кнопкой геолокации «Где я», телефонами и врачами каталога RuDoctors.
      </p>
    </div>

    <!-- Interactive Map Component -->
    <ClinicsMap />

    <!-- Explanatory Guide Section -->
    <div class="mt-12 pt-8 border-t border-slate-200 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 text-sm">
      <div class="card p-5">
        <div class="w-9 h-9 rounded-xl bg-cyan-100 text-cyan-800 flex items-center justify-center text-lg mb-3">
          🏛️
        </div>
        <h3 class="font-bold text-slate-900 text-base">Дом здравља</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Первичная государственная помощь по месту проживания: выбор терапевта (izabrani lekar), вакцинация, базовая диагностика по полису RFZO (или платно через кассу) и дежурные врачи в выходные дни.
        </p>
      </div>

      <div class="card p-5">
        <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center text-lg mb-3">
          💊
        </div>
        <h3 class="font-bold text-slate-900 text-base">Дежурные аптеки 24/7</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Круглосуточные дежурные филиалы «Апотека Београд» (Теразие, Немањина, Нови Београд, Земун) и аптеки в Нови-Саде и Нише. Отпуск рецептурных медикаментов по рецептам врачей.
        </p>
        <a href="/guides/apteki-retsepty-serbia/" class="mt-3 inline-block text-xs font-semibold text-brand-700 hover:underline">
          Гид по аптекам и рецептам →
        </a>
      </div>

      <div class="card p-5">
        <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center text-lg mb-3">
          🚨
        </div>
        <h3 class="font-bold text-slate-900 text-base">Стационары и КБЦ 24/7</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Экстренная хирургия и терапия: Ургентный центр (UKCS), Военно-медицинская академия (ВМА), КБЦ Др Драгиша Мишовић, КБЦ Звездара и КБЦ Земун, принимающие пациентов круглосуточно.
        </p>
      </div>

      <div class="card p-5">
        <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center text-lg mb-3">
          👶
        </div>
        <h3 class="font-bold text-slate-900 text-base">Детская неотложка</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Для детей 24/7 открыты Университетская клиника в Тиршовой (UDK Tiršova) и Институт матери и ребенка. Главный акушерский стационар и роддом Белграда — ГАК Народни Фронт.
        </p>
      </div>

      <div class="card p-5 sm:col-span-2 lg:col-span-1">
        <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center text-lg mb-3">
          🏥
        </div>
        <h3 class="font-bold text-slate-900 text-base">Частные центры</h3>
        <p class="mt-2 text-xs text-slate-600 leading-relaxed">
          Ведущие частные сети (MediGroup, Euromedic, Bel Medic, Vizim) и профильные ординации. В карточке филиала отображаются русскоязычные специалисты каталога RuDoctors.
        </p>
      </div>
    </div>
  </div>
</Layout>
