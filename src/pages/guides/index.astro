---
import Layout from "../../layouts/Layout.astro";

const title = "Гайды по здоровью в Сербии";
const description =
  "Навигационные гайды Rudoctors: поиск врача, государственная и приватная клиника, страховка, запись, лабораторные анализы. Материалы в статусе черновика.";

const guides = [
  {
    slug: "finding-doctor",
    title: "Как найти врача в Сербии",
    description: "Поиск врача через каталог: города, специальности, карточки.",
  },
  {
    slug: "public-private-care",
    title: "Государственная поликлиника и приватная клиника",
    description: "Разница между государственной поликлиникой и приватной клиникой.",
  },
  {
    slug: "insurance-appointments",
    title: "Страховка и запись к врачу",
    description: "Как страховка и запись связаны между собой.",
  },
  {
    slug: "choosing-clinic",
    title: "Как выбрать клинику и записаться",
    description: "Оценка клиники и оформление записи.",
  },
  {
    slug: "labs-diagnostics-belgrade",
    title: "Лабораторные анализы и диагностика в Белграде",
    description: "Навигация по лабораторным анализам и диагностике в Белграде.",
  },
];
---

<Layout
  title={title}
  description={description}
  noindex
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Гайды", path: "/guides/" },
  ]}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <div class="card p-4 mb-8 border-l-4 border-amber-400 bg-amber-50">
      <p class="text-sm font-semibold text-amber-900">Черновик (draft)</p>
      <p class="mt-1 text-sm text-slate-700">
        Материал находится в статусе черновика: источник, дата и медицинское/источниковедческое
        ревью ещё не заполнены. До заполнения этих данных текст не должен публиковаться.
        Гайды не являются медицинскими рекомендациями и не заменяют консультацию врача.
      </p>
    </div>

    <h1 class="text-3xl md:text-4xl font-extrabold text-navy-900">{title}</h1>
    <p class="mt-3 text-slate-600 leading-relaxed">
      Навигационные гайды по вопросам здоровья в Сербии. Материалы подготовлены в статусе
      черновика: содержание не прошло источниковедческую проверку и медицинское ревью, поэтому
      не должен использоваться как медицинская рекомендация.
    </p>

    <div class="mt-10 grid gap-4">
      {
        guides.map((g) => (
          <a href={`/guides/${g.slug}/`} class="card p-5 block">
            <h2 class="font-extrabold text-navy-900">{g.title}</h2>
            <p class="mt-1 text-sm text-slate-600">{g.description}</p>
          </a>
        ))
      }
    </div>

    <div class="card p-6 mt-10 text-center">
      <h2 class="font-extrabold text-navy-900">Что дальше</h2>
      <p class="mt-2 text-sm text-slate-600">
        Основной справочный ресурс — <a href="/doctors/" class="text-brand-700 hover:underline">каталог врачей</a>.
        Черновики гайдов появятся здесь по мере подготовки источников.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href="/doctors/" class="btn-primary">Найти врача</a>
        <a href="/faq/" class="btn-ghost">Вопросы и ответы</a>
        <a href="/contacts/" class="btn-ghost">Связаться</a>
      </div>
    </div>
  </div>
</Layout>
