---
import Layout from "../layouts/Layout.astro";
import { publicDoctors } from "../lib/doctors";
import { SITE } from "../lib/site";

const doctors = publicDoctors()
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name, "ru"))
  .map((d) => ({ slug: d.slug, name: d.name }));
---

<Layout
  title="Оставить отзыв"
  description="Оставьте отзыв о враче из каталога Rudoctors — он поможет другим пациентам."
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-navy-900">Оставить отзыв</h1>
    <p class="mt-2 text-slate-600">
      Заполните форму — отзыв будет отправлен на проверку редакции и опубликован после модерации.
    </p>

    <div class="mt-4 rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-900">
      <strong>Как это работает:</strong> отзывы проходят быструю проверку редакции на отсутствие спама и рекламы, после чего публикуются в каталоге. Пожалуйста, не указывайте конфиденциальные диагнозы и персональные данные третьих лиц.
    </div>

    <form id="review-form" class="card p-6 mt-6 space-y-4">
      <div>
        <label class="block text-sm font-semibold mb-1" for="doctor">Врач</label>
        <select id="doctor" name="doctor" class="input" required>
          <option value="">Выберите врача…</option>
          {doctors.map((d) => <option value={d.slug}>{d.name}</option>)}
        </select>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="author">Ваше имя (или псевдоним)</label>
          <input id="author" name="author" class="input" required maxlength="80" placeholder="Анна" autocomplete="name" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="rating">Оценка (необязательно)</label>
          <select id="rating" name="rating" class="input">
            <option value="">Без оценки</option>
            <option value="5">5 — отлично</option>
            <option value="4">4 — хорошо</option>
            <option value="3">3 — нормально</option>
            <option value="2">2 — плохо</option>
            <option value="1">1 — ужасно</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="text">Текст отзыва</label>
        <textarea
          id="text"
          name="text"
          class="input min-h-36"
          required
          minlength="30"
          maxlength="2000"
          placeholder="Расскажите о приёме: как прошло, что понравилось, помогло ли лечение…"></textarea>
        <div class="text-xs text-slate-400 mt-1">Минимум 30 символов. Без персональных данных третьих лиц.</div>
      </div>

      <!-- honeypot -->
      <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
        <label for="website_trap">Website</label>
        <input id="website_trap" name="website_trap" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="flex items-start gap-2 text-sm text-slate-600">
        <input type="checkbox" name="consent" required class="mt-1 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        Подтверждаю, что отзыв описывает мой личный опыт; согласен с
        <a href="/about/#reviews-policy" class="text-brand-700 underline">правилами публикации</a> и
        <a href="/privacy/" class="text-brand-700 underline">политикой конфиденциальности</a>.
      </label>

      <button type="submit" id="submit-btn" class="btn-primary w-full !py-3 font-bold text-base">
        Отправить отзыв
      </button>
      <p id="form-status" class="text-sm text-slate-500 hidden" role="status" aria-live="polite"></p>
    </form>

    <!-- Inline success screen (hidden by default) -->
    <div id="review-success" class="card p-6 mt-6 border-2 border-emerald-200 bg-emerald-50/40 hidden">
      <div class="flex items-center gap-2 text-emerald-800 font-extrabold text-lg">
        <svg class="w-6 h-6 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Отзыв принят на проверку!
      </div>
      <p id="review-id-line" class="mt-2 text-sm text-slate-700 font-mono"></p>
      <p class="mt-3 text-sm text-slate-600">
        Спасибо за ваш отзыв. После проверки редакцией он появится в каталоге на странице врача.
      </p>
    </div>

    <div class="mt-8 flex items-center justify-between text-sm text-slate-500 border-t border-slate-200 pt-6">
      <div>
        Разработчик: <a href={SITE.developerTelegram} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline font-medium">{SITE.developerTelegramLabel}</a>
      </div>
      <div>
        Сообщество: <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline font-medium">{SITE.telegramLabel}</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { isHoneypotFilled, cooldownRemainingMs, markSubmitted, formatCooldown } from "../lib/formGuard";

  const RELAY_URL = "https://rudoctors-relay.deno.dev/api/review";

  const form = document.getElementById("review-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const successBox = document.getElementById("review-success");
  const reviewIdLine = document.getElementById("review-id-line");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const sel = document.getElementById("doctor") as HTMLSelectElement | null;
  const KEY = "leave-review";

  // Pre-fill doctor from URL param
  const params = new URLSearchParams(location.search);
  const pre = params.get("doctor");
  if (pre && sel) sel.value = pre;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;

    // Honeypot guard
    if (isHoneypotFilled(form)) {
      if (status) {
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = "Форма отправлена.";
        status.classList.remove("hidden");
      }
      return;
    }

    // Cooldown guard
    const wait = cooldownRemainingMs(KEY, 90_000);
    if (wait > 0) {
      if (status) {
        status.classList.remove("hidden");
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = formatCooldown(wait);
      }
      return;
    }

    const fd = new FormData(form);
    const doctorSlug = String(fd.get("doctor") || "").trim();
    const doctorName = sel?.selectedOptions[0]?.text || doctorSlug;
    const author = String(fd.get("author") || "").trim();
    const ratingRaw = String(fd.get("rating") || "").trim();
    const ratingNum = Number(ratingRaw);
    // Оценка опциональна: отправляем поле ТОЛЬКО когда выбрано целое 1..5.
    // Пустая оценка → без rating в JSON; никакого «|| 5» — на relay-стороне тоже.
    const hasRating = ratingRaw !== "" && Number.isInteger(ratingNum) && ratingNum >= 1 && ratingNum <= 5;
    const text = String(fd.get("text") || "").trim();

    // Client-side validation
    if (!doctorSlug || !author || text.length < 30) {
      if (status) {
        status.classList.remove("hidden");
        status.className = "text-sm mt-2 text-red-600";
        status.textContent = !doctorSlug || !author
          ? "Выберите врача и укажите имя."
          : "Отзыв должен содержать не менее 30 символов.";
      }
      if (!doctorSlug) sel?.focus();
      else if (!author) document.getElementById("author")?.focus();
      else document.getElementById("text")?.focus();
      return;
    }

    // Loading state
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Отправляем…";
    }
    if (status) status.classList.add("hidden");

    try {
      const res = await fetch(RELAY_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          doctor_slug: doctorSlug,
          doctor_name: doctorName,
          author,
          ...(hasRating ? { rating: ratingNum } : {}),
          text,
          website_hp: String(fd.get("website_trap") || ""),
        }),
      });

      const data = await res.json().catch(() => ({ ok: false })) as { ok: boolean; id?: string; error?: string };

      if (data.ok) {
        markSubmitted(KEY);
        // Show success screen
        form.classList.add("hidden");
        if (successBox) successBox.classList.remove("hidden");
        if (reviewIdLine && data.id) {
          reviewIdLine.textContent = `Номер отзыва: ${data.id}`;
        }
        successBox?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } else {
        throw new Error(data.error || "Неизвестная ошибка");
      }
    } catch (err) {
      if (status) {
        status.classList.remove("hidden");
        status.className = "text-sm mt-2 text-red-600";
        status.textContent = `Ошибка отправки: ${String(err).slice(0, 120)}. Попробуйте позже.`;
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Отправить отзыв";
      }
    }
  });
</script>
