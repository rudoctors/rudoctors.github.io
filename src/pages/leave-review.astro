---
import Layout from "../layouts/Layout.astro";
import { publicDoctors } from "../lib/doctors";
import { SITE } from "../lib/site";

const doctors = publicDoctors()
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name, "ru"))
  .map((d) => ({ slug: d.slug, name: d.name }));
---

<Layout
  title="Оставить отзыв"
  description="Оставьте отзыв о враче из каталога Rudoctors — он поможет другим пациентам."
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-navy-900">Оставить отзыв</h1>
    <p class="mt-2 text-slate-600">
      Заполните форму — мы откроем предзаполненную страницу GitHub. После подтверждения заявка станет
      публичной Issue, а отзыв будет опубликован после модерации.
    </p>
    <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
      <strong>Важно:</strong> откроется предзаполненная публичная форма GitHub. Только после отдельного
      подтверждения текст отзыва, имя автора и дата станут публичной Issue, доступной всем без исключения.
      Отзыв может содержать сведения о здоровье — не включайте конфиденциальные сведения и персональные
      данные третьих лиц. Как обрабатываются данные — в
      <a href="/privacy/" class="underline">политике конфиденциальности</a>.
    </p>

    <form id="review-form" class="card p-6 mt-8 space-y-4">
      <div>
        <label class="block text-sm font-semibold mb-1" for="doctor">Врач</label>
        <select id="doctor" name="doctor" class="input" required>
          <option value="">Выберите врача…</option>
          {doctors.map((d) => <option value={d.slug}>{d.name}</option>)}
        </select>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="author">Ваше имя</label>
          <input id="author" name="author" class="input" required maxlength="80" placeholder="Анна" autocomplete="name" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="rating">Оценка</label>
          <select id="rating" name="rating" class="input" required>
            <option value="5">5 — отлично</option>
            <option value="4">4 — хорошо</option>
            <option value="3">3 — нормально</option>
            <option value="2">2 — плохо</option>
            <option value="1">1 — ужасно</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="text">Отзыв</label>
        <textarea
          id="text"
          name="text"
          class="input min-h-36"
          required
          minlength="30"
          maxlength="2000"
          placeholder="Расскажите о приёме: как прошло, что понравилось, что нет…"></textarea>
        <div class="text-xs text-slate-400 mt-1">Минимум 30 символов. Без персональных данных третьих лиц.</div>
      </div>

      <!-- honeypot -->
      <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
        <label for="website_trap">Website</label>
        <input id="website_trap" name="website_trap" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="flex items-start gap-2 text-sm text-slate-600">
        <input type="checkbox" name="consent" required class="mt-1 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        Понимаю, что после подтверждения данные станут публичной GitHub Issue; отзыв — мой личный опыт;
        согласен с <a href="/about/#reviews-policy" class="text-brand-700 underline">правилами публикации</a> и
        <a href="/privacy/" class="text-brand-700 underline">политикой конфиденциальности</a>.
      </label>

      <button type="submit" class="btn-primary w-full">Отправить на модерацию</button>
      <p id="form-status" class="text-sm text-slate-500 hidden" role="status" aria-live="polite"></p>
    </form>

    <div class="mt-6 text-sm text-slate-500">
      Или напишите напрямую в сообщество:
      <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">{SITE.telegramLabel}</a>
    </div>
  </div>
</Layout>

<script>
  import { isHoneypotFilled, cooldownRemainingMs, markSubmitted, formatCooldown } from "../lib/formGuard";

  const form = document.getElementById("review-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const KEY = "leave-review";

  const params = new URLSearchParams(location.search);
  const pre = params.get("doctor");
  const sel = document.getElementById("doctor") as HTMLSelectElement | null;
  if (pre && sel) sel.value = pre;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;

    if (isHoneypotFilled(form)) {
      if (status) {
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = "Форма отправлена.";
      }
      return;
    }

    const wait = cooldownRemainingMs(KEY, 90_000);
    if (wait > 0) {
      if (status) {
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = formatCooldown(wait);
      }
      return;
    }

    const fd = new FormData(form);
    const doctor = String(fd.get("doctor") || "").trim();
    const author = String(fd.get("author") || "").trim();
    const rating = String(fd.get("rating") || "5").trim();
    const text = String(fd.get("text") || "").trim();

    if (!doctor || !author || text.length < 30) {
      if (status) {
        status.className = "text-sm mt-2 text-red-600";
        status.textContent = doctor || !author
          ? "Выберите врача и укажите имя без пустых пробелов."
          : "Отзыв должен содержать не менее 30 символов.";
      }
      if (!doctor) sel?.focus();
      else if (!author) document.getElementById("author")?.focus();
      else document.getElementById("text")?.focus();
      return;
    }

    const title = `Отзыв: ${doctor} (${rating}★)`;
    const body = [
      `**Врач:** ${doctor}`,
      `**Автор:** ${author}`,
      `**Оценка:** ${rating}/5`,
      `**Дата:** ${new Date().toISOString().slice(0, 10)}`,
      "",
      text,
      "",
      "---",
      "_Создано через форму rudoctors.github.io_",
    ].join("\n");

    const url = `https://github.com/rudoctors/rudoctors.github.io/issues/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}&labels=review`;
    markSubmitted(KEY);
    if (status) {
      status.className = "text-sm mt-2 text-slate-500";
      status.textContent = "Открываем форму GitHub для отправки отзыва…";
    }
    window.open(url, "_blank", "noopener,noreferrer");
  });
</script>
