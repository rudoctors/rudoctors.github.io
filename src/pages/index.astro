---
import Layout from "../layouts/Layout.astro";
import DoctorCard from "../components/DoctorCard.astro";
import Banner from "../components/Banner.astro";
import { publicDoctors, allSpecializationKeys, specLabel, siteStats, allCities } from "../lib/doctors";
import { computeRating } from "../lib/rating";
import { SITE, SCHEMA_IDS, plural, citySlug, cityLabel } from "../lib/site";

const stats = siteStats();
const top = publicDoctors()
  .map((d) => ({ d, r: computeRating(d) }))
  .filter((x) => x.r.count > 0)
  .sort((a, b) => b.r.average - a.r.average || b.r.count - a.r.count || (b.d.updatedAt || "").localeCompare(a.d.updatedAt || ""))
  .slice(0, 6)
  .map((x) => x.d);

const specs = allSpecializationKeys().slice(0, 16);
const cities = allCities();
const fresh = publicDoctors()
  .slice()
  .sort((a, b) => (b.updatedAt || "").localeCompare(a.updatedAt || ""))
  .slice(0, 6);

const allDocs = publicDoctors();
const belgradeDocs = allDocs.filter((d) => d.city === "Belgrade");
const noviSadDocs = allDocs.filter((d) => d.city === "Novi Sad");

const BELGRADE_TOP_SPECS = [
  "pediatrician",
  "dentist",
  "gynecologist",
  "psychiatrist",
  "therapist",
  "cardiologist",
  "dermatologist",
  "neurologist",
  "ultrasound_diagnostics",
  "surgeon",
  "gastroenterologist",
  "otorhinolaryngologist",
  "endocrinologist",
  "psychologist",
  "traumatologist_orthopedist",
  "urologist",
];

const NOVI_SAD_TOP_SPECS = [
  "dentist",
  "pediatrician",
  "ultrasound_diagnostics",
  "gynecologist",
  "therapist",
  "psychiatrist",
  "dermatologist",
  "cardiologist",
  "neurologist",
  "surgeon",
  "gastroenterologist",
  "ophthalmologist",
];

const belgradeClusters = BELGRADE_TOP_SPECS.map((s) => ({
  key: s,
  label: specLabel(s),
  count: belgradeDocs.filter((d) => d.specializations.includes(s)).length,
})).filter((c) => c.count > 0);

const noviSadClusters = NOVI_SAD_TOP_SPECS.map((s) => ({
  key: s,
  label: specLabel(s),
  count: noviSadDocs.filter((d) => d.specializations.includes(s)).length,
})).filter((c) => c.count > 0);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": SCHEMA_IDS.website,
    name: SITE.name,
    url: SITE.url,
    inLanguage: "ru",
    description: SITE.description,
    publisher: { "@id": SCHEMA_IDS.organization },
    potentialAction: {
      "@type": "SearchAction",
      target: `${SITE.url}/doctors/?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": SCHEMA_IDS.organization,
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/og.png`,
    description: SITE.description,
    areaServed: { "@type": "Country", name: "Serbia" },
    sameAs: ["https://github.com/rudoctors/rudoctors.github.io"],
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      url: `${SITE.url}/contacts/`,
    },
  },
];
---

<Layout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-700 via-brand-800 to-navy-900 text-white">
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_20%_20%,#2dd4bf_0,transparent_40%),radial-gradient(circle_at_80%_60%,#fb923c_0,transparent_35%)]"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-16 md:pt-20 md:pb-24">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1 text-xs font-medium text-brand-100">
          Медицина в Сербии на русском языке
        </div>
        <h1 class="mt-4 text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">
          Русскоязычные врачи<br class="hidden sm:block" />
          и клиники в Сербии
        </h1>
        <p class="mt-4 text-base md:text-lg text-brand-50/90 leading-relaxed">
          Проверенные рейтинги, честные отзывы пациентов и прямые контакты: стоматология, педиатрия, гинекология, терапия — Белград, Нови-Сад и вся Сербия.
        </p>

        <form action="/doctors/" method="get" class="mt-8 flex flex-col sm:flex-row gap-3 max-w-2xl">
          <input
            type="search"
            name="q"
            class="input !bg-white !text-slate-900 !border-0 h-12 text-base flex-1"
            placeholder="Имя, специальность или город…"
            aria-label="Поиск врача"
          />
          <button type="submit" class="btn bg-accent-700 hover:bg-accent-800 text-white font-bold h-12 px-6 text-base shadow-sm">
            Найти
          </button>
        </form>

        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
          <span class="text-brand-200">Быстрый поиск:</span>
          <a
            href="/doctors/?origin=ru"
            class="inline-flex items-center gap-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 px-3 py-1 text-white transition"
          >
            <span>Русскоязычные врачи ({stats.russianDoctors})</span>
          </a>
          <a
            href="/doctors/serbian/"
            class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/25 hover:bg-rose-500/35 border border-rose-300/30 px-3 py-1 font-semibold text-rose-100 transition shadow-xs"
          >
            <span aria-hidden="true">🇷🇸</span>
            <span>Сербские врачи ({stats.serbianDoctors})</span>
          </a>
          <a
            href="/map/"
            class="inline-flex items-center gap-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 px-3 py-1 text-white transition"
          >
            <span>📍 Карта клиник</span>
          </a>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-brand-100/90">
          <span><strong class="text-white">{stats.doctors}</strong> {plural(stats.doctors, "врач", "врача", "врачей")} в каталоге</span>
          <span class="text-brand-400">·</span>
          <a href="/doctors/?origin=ru" class="hover:underline hover:text-white">
            <strong class="text-white">{stats.russianDoctors}</strong> русскоязычных
          </a>
          <span class="text-brand-400">·</span>
          <a href="/doctors/serbian/" class="hover:underline hover:text-white inline-flex items-center gap-1">
            <span aria-hidden="true">🇷🇸</span>
            <strong class="text-white">{stats.serbianDoctors}</strong> сербских врачей
          </a>
          <span class="text-brand-400">·</span>
          <span><strong class="text-white">{stats.reviews}</strong> {plural(stats.reviews, "отзыв", "отзыва", "отзывов")}</span>
          <span class="text-brand-400">·</span>
          <span><strong class="text-white">{stats.specializations}</strong> {plural(stats.specializations, "специальность", "специальности", "специальностей")}</span>
          <span class="text-brand-400">·</span>
          <span><strong class="text-white">{stats.cities}</strong> {plural(stats.cities, "город", "города", "городов")}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialties -->
  <section class="mx-auto max-w-6xl px-4 -mt-8 relative z-10">
    <div class="card p-5 md:p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-navy-900">Специальности</h2>
        <a href="/specialties/" class="text-sm text-brand-700 font-semibold hover:underline">Все →</a>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          specs.map((s) => (
            <a href={`/specialties/${s}/`} class="chip hover:bg-brand-100 transition">
              {specLabel(s)}
            </a>
          ))
        }
      </div>
      {
        cities.length > 0 && (
          <div class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap gap-2 items-center">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide mr-1">Города:</span>
            {cities.map((c) => (
              <a href={`/cities/${citySlug(c)}/`} class="text-sm text-slate-600 hover:text-brand-700 underline-offset-2 hover:underline">
                {cityLabel(c)}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- SEO Matrix: Clusters Belgrade & Novi Sad -->
  <section class="mx-auto max-w-6xl px-4 mt-6" aria-labelledby="clusters-heading">
    <div class="card p-5 md:p-6 bg-gradient-to-br from-white via-slate-50/50 to-brand-50/30">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
        <div>
          <h2 id="clusters-heading" class="text-lg md:text-xl font-extrabold text-navy-900 flex items-center gap-2">
            <span>🗺️</span>
            <span>Врачи по городам и направлениям</span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Прямой переход к проверенным специалистам, прейскурантам и дежурным клиникам в крупнейших городах Сербии
          </p>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Belgrade Column -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs">
          <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="text-xl">🏛️</span>
              <div>
                <h3 class="font-bold text-navy-900 text-base">Врачи в Белграде</h3>
                <p class="text-[11px] text-slate-500">{belgradeDocs.length} специалистов в столице</p>
              </div>
            </div>
            <a href="/cities/belgrade/" class="text-xs font-semibold text-brand-700 hover:underline">
              Все в Белграде →
            </a>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {belgradeClusters.map((c) => (
              <a
                href={`/cities/belgrade/${c.key}/`}
                class="chip hover:bg-brand-50 hover:text-brand-700 hover:border-brand-300 transition text-xs py-1"
                title={`${c.label} в Белграде — ${c.count} ${plural(c.count, "врач", "врача", "врачей")}`}
              >
                <span>{c.label}</span>
                <span class="text-slate-400 text-[10px]">({c.count})</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Novi Sad Column -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs">
          <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="text-xl">🏰</span>
              <div>
                <h3 class="font-bold text-navy-900 text-base">Врачи в Нови-Саде</h3>
                <p class="text-[11px] text-slate-500">{noviSadDocs.length} специалистов в Воеводине</p>
              </div>
            </div>
            <a href="/cities/novi-sad/" class="text-xs font-semibold text-brand-700 hover:underline">
              Все в Нови-Саде →
            </a>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {noviSadClusters.map((c) => (
              <a
                href={`/cities/novi-sad/${c.key}/`}
                class="chip hover:bg-brand-50 hover:text-brand-700 hover:border-brand-300 transition text-xs py-1"
                title={`${c.label} в Нови-Саде — ${c.count} ${plural(c.count, "врач", "врача", "врачей")}`}
              >
                <span>{c.label}</span>
                <span class="text-slate-400 text-[10px]">({c.count})</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Regional Centers -->
      <div class="mt-5 pt-4 border-t border-slate-200/80 flex flex-wrap gap-2 items-center text-xs">
        <span class="font-bold text-slate-500 uppercase tracking-wider text-[11px] mr-1">Другие регионы:</span>
        <a href="/cities/subotica/" class="chip hover:bg-slate-100">Суботица ({allDocs.filter(d => d.city === "Subotica").length})</a>
        <a href="/cities/nis/" class="chip hover:bg-slate-100">Ниш ({allDocs.filter(d => d.city === "Niš").length})</a>
        <a href="/cities/vrbas/" class="chip hover:bg-slate-100">Врбас ({allDocs.filter(d => d.city === "Vrbas").length})</a>
        <a href="/cities/pancevo/" class="chip hover:bg-slate-100">Панчево ({allDocs.filter(d => d.city === "Pančevo").length})</a>
        <a href="/cities/sombor/" class="chip hover:bg-slate-100">Сомбор ({allDocs.filter(d => d.city === "Sombor").length})</a>
        <a href="/cities/kragujevac/" class="chip hover:bg-slate-100">Крагуевац ({allDocs.filter(d => d.city === "Kragujevac").length})</a>
        <a href="/cities/" class="text-brand-700 font-semibold hover:underline ml-auto">Все города Сербии (26) →</a>
      </div>
    </div>
  </section>

  <Banner placement="home-top" class="mx-auto max-w-6xl px-4 mt-10" />


  <!-- Top rated -->
  <section class="mx-auto max-w-6xl px-4 mt-12">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl md:text-2xl font-extrabold text-navy-900">Врачи Сербии</h2>
      <a href="/doctors/?sort=rating" class="text-sm text-brand-700 font-semibold hover:underline">Смотреть все →</a>
    </div>
    {
      top.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {top.map((d) => (
            <DoctorCard doctor={d} />
          ))}
        </div>
      ) : (
        <div class="card p-8 text-center text-slate-500">
          В каталоге формируется подборка врачей. Вы можете{" "}
          <a href="/leave-review/" class="text-brand-700 font-semibold hover:underline" rel="nofollow">оставить отзыв</a>.
        </div>
      )
    }
  </section>

  <!-- Recently updated -->
  <section class="mx-auto max-w-6xl px-4 mt-12">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-xl md:text-2xl font-extrabold text-navy-900">Новые и обновлённые карточки</h2>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {fresh.map((d) => <DoctorCard doctor={d} />)}
    </div>
  </section>

  <!-- Guides preview -->
  <section class="mx-auto max-w-6xl px-4 mt-12">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h2 class="text-xl md:text-2xl font-extrabold text-navy-900">Гайды по медицине в Сербии</h2>
        <p class="text-sm text-slate-500 mt-1">Государственные клиники, страховка RFZO и ДМС, анализы, лекарства и поиск врачей</p>
      </div>
      <a href="/guides/" class="text-sm text-brand-700 font-semibold hover:underline hidden sm:inline">Все гайды (10) →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <a href="/guides/public-private-care/" class="card p-5 hover:border-brand-300 hover:shadow-md transition flex flex-col justify-between">
        <div>
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded bg-brand-50 text-brand-700 mb-2">Госсистема vs Частные</span>
          <h3 class="font-bold text-navy-900 text-base mb-2">Дом здравља или частная клиника: куда идти?</h3>
          <p class="text-xs text-slate-500 line-clamp-2">Разница между государственными поликлиниками и частными центрами в Сербии, стоимость приёма и очереди.</p>
        </div>
        <div class="mt-4 text-xs font-semibold text-brand-700 flex items-center gap-1">Читать гайд →</div>
      </a>
      <a href="/guides/insurance-appointments/" class="card p-5 hover:border-brand-300 hover:shadow-md transition flex flex-col justify-between">
        <div>
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded bg-brand-50 text-brand-700 mb-2">Страховка</span>
          <h3 class="font-bold text-navy-900 text-base mb-2">Медицинская страховка: RFZO vs ДМС</h3>
          <p class="text-xs text-slate-500 line-clamp-2">Как работает государственная страховка RFZO и когда выгоднее оформить частный полис Generali / Uniqa / Dunav.</p>
        </div>
        <div class="mt-4 text-xs font-semibold text-brand-700 flex items-center gap-1">Читать гайд →</div>
      </a>
      <a href="/guides/apteki-retsepty-serbia/" class="card p-5 hover:border-brand-300 hover:shadow-md transition flex flex-col justify-between">
        <div>
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded bg-brand-50 text-brand-700 mb-2">Аптеки</span>
          <h3 class="font-bold text-navy-900 text-base mb-2">Аптеки и лекарства: аналоги и рецепты</h3>
          <p class="text-xs text-slate-500 line-clamp-2">Как купить привычные препараты, сербские названия действующих веществ (INN), дежурные аптеки 00–24.</p>
        </div>
        <div class="mt-4 text-xs font-semibold text-brand-700 flex items-center gap-1">Читать гайд →</div>
      </a>
    </div>
    <div class="mt-4 text-center sm:hidden">
      <a href="/guides/" class="btn-secondary w-full justify-center">Все 10 медицинских гайдов →</a>
    </div>
  </section>

  <Banner placement="home-bottom" class="mx-auto max-w-6xl px-4 mt-12" />

  <!-- Monetization slot -->
  <section class="mx-auto max-w-6xl px-4 mt-14">
    <div class="rounded-3xl border-2 border-dashed border-brand-300 bg-brand-50 p-7 md:p-8 max-w-3xl mx-auto text-center">
      <div class="text-xs font-bold uppercase tracking-widest text-brand-700">Врачам и клиникам</div>
      <h3 class="mt-2 text-2xl font-extrabold text-navy-900">Баннерная реклама</h3>
      <p class="mt-2 text-sm text-slate-600 leading-relaxed max-w-xl mx-auto">
        Слоты на главной и в категориях: город, специальность, статистика показов и переходов.
      </p>
      <a href="/contacts/?topic=banner" class="btn-primary mt-5 inline-block" rel="nofollow">Запросить размещение</a>
    </div>
  </section>
</Layout>
