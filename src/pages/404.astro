---
import Layout from "../layouts/Layout.astro";
import { allCities } from "../lib/doctors";
import { citySlug } from "../lib/site";

const cities = allCities()
  .map((c) => ({
    city: c,
    href: `/cities/${citySlug(c)}/`,
    count: 0,
  }))
  .slice(0, 8);
---

<Layout title="Страница не найдена" description="Такой страницы нет на Rudoctors." noindex>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <div class="text-7xl font-extrabold text-brand-600">404</div>
    <h1 class="mt-4 text-2xl md:text-3xl font-extrabold text-navy-900">Страница не найдена</h1>
    <p class="mt-3 text-slate-600">
      Возможно, ссылка устарела или в адресе опечатка. Найдите врача через каталог или начните с города.
    </p>

    <form
      action="/doctors/"
      method="get"
      class="mt-8 card p-4 flex flex-col sm:flex-row gap-3 items-stretch"
      role="search"
    >
      <label class="sr-only" for="q404">Поиск врача</label>
      <input
        id="q404"
        name="q"
        type="search"
        class="input flex-1"
        placeholder="Имя врача, специальность…"
        autocomplete="off"
      />
      <button type="submit" class="btn-primary">Найти</button>
    </form>

    <div class="mt-8">
      <p class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Города</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        <a href="/doctors/" class="btn-ghost">Каталог</a>
        <a href="/specialties/" class="btn-ghost">Специальности</a>
        {
          cities.map((c) => (
            <a href={c.href} class="chip hover:bg-brand-100">
              {c.city}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">На главную</a>
      <a href="/faq/" class="btn-ghost">FAQ</a>
      <a href="/contacts/" class="btn-ghost">Контакты</a>
    </div>
  </div>
</Layout>
