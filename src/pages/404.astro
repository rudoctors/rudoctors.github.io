---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Страница не найдена" description="Такой страницы нет на Rudoctors." noindex>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <div class="text-7xl font-extrabold text-brand-600">404</div>
    <h1 class="mt-4 text-2xl md:text-3xl font-extrabold text-navy-900">Страница не найдена</h1>
    <p class="mt-3 text-slate-600">
      Возможно, ссылка устарела или в адресе опечатка. Попробуйте найти врача через каталог.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">На главную</a>
      <a href="/doctors/" class="btn-ghost">Каталог врачей</a>
      <a href="/specialties/" class="btn-ghost">Специальности</a>
    </div>
  </div>
</Layout>
