---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "Что такое Rudoctors?",
    a: "Rudoctors — независимый каталог русскоязычных врачей в Сербии. Мы собираем специализации, опыт, клиники, контакты и отзывы пациентов, чтобы сообществу было проще найти врача, которому доверяешь.",
  },
  {
    q: "Как найти русского врача в Белграде?",
    a: "Откройте раздел «Города» → Belgrade или выберите специальность в разделе «Специальности». В карточках указаны языки приёма, район, клиника, рейтинг и контакты для записи.",
  },
  {
    q: "Бесплатно ли пользоваться каталогом?",
    a: "Да, поиск, рейтинги и просмотр карточек бесплатны. Платное featured-продвижение — отдельная услуга для врачей и клиник: условия и цены на странице «Пакеты размещения» (ссылка в меню и в футере).",
  },
  {
    q: "Как оставить отзыв о враче?",
    a: "Найдите врача в каталоге и нажмите «Оставить отзыв» в его карточке, либо заполните общую форму. Отзывы проходят модерацию перед публикацией.",
  },
  {
    q: "Как добавить врача в каталог?",
    a: "Заполните форму «Добавить врача» — после проверки данных карточка появится в каталоге. Врачи и клиники также могут прислать данные через Telegram-чат сообщества.",
  },
  {
    q: "Как формируется рейтинг врача?",
    a: "Рейтинг учитывает оценки, количество отзывов, свежесть и детальность текста. Накрутка рейтинга не продаётся и запрещена политикой проекта.",
  },
  {
    q: "Можно ли удалить или исправить отзыв?",
    a: "Да. Врач или пациент могут запросить проверку, исправление или удаление отзыва через страницу контактов или Telegram-чат. Запросы рассматриваются в разумный срок.",
  },
  {
    q: "В каких городах Сербии есть врачи?",
    a: "В каталоге — Белград, Нови-Сад и Суботица. Основная база специалистов сосредоточена в Белграде, включая районы Нови-Београд, Врачар и Стари Град.",
  },
  {
    q: "На каких языках принимают врачи?",
    a: "Большинство специалистов каталога принимают на русском и сербском, многие — на английском. Языки приёма указаны в каждой карточке.",
  },
  {
    q: "Заменяет ли каталог консультацию врача?",
    a: "Нет. Материалы Rudoctors носят справочный характер и не заменяют очную консультацию. Диагноз и лечение назначает только специалист.",
  },
  {
    q: "Есть ли у проекта Telegram-чат?",
    a: "Да — чат «Медицина в Сербии» (@vrachivserbii): живые рекомендации, записи к врачам и опыт сообщества.",
  },
  {
    q: "Можно ли продвигать профиль врача или клиники?",
    a: "Да. Featured-профиль вверху каталога и на главной, а также баннерные места для клиник — по запросу. Подробности в разделе «Врачам и клиникам».",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title="Вопросы и ответы"
  description="FAQ Rudoctors: как найти русского врача в Сербии, оставить отзыв, добавить карточку и как работает рейтинг."
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Вопросы и ответы", path: "/faq/" },
  ]}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold text-navy-900">Вопросы и ответы</h1>
    <p class="mt-3 text-slate-600">
      Коротко о каталоге Rudoctors: поиск врача, отзывы, рейтинги и сотрудничество.
    </p>

    <div class="mt-8 space-y-4">
      {
        faqs.map((f) => (
          <details class="card p-5 group">
            <summary class="font-bold text-navy-900 cursor-pointer list-none flex items-start justify-between gap-4">
              <span>{f.q}</span>
              <span class="text-brand-600 shrink-0 group-open:rotate-45 transition">+</span>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-10 card p-6 text-center">
      <p class="text-slate-600">Не нашли ответ?</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href="/contacts/" class="btn-primary">Связаться</a>
        <a href="/doctors/" class="btn-ghost">Найти врача</a>
      </div>
    </div>
  </div>
</Layout>
