---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";
---

<Layout
  title="Добавить врача"
  description="Добавьте карточку русскоязычного врача в каталог Rudoctors."
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-navy-900">Добавить врача</h1>
    <p class="mt-2 text-slate-600">
      Карточку можно предложить бесплатно. После проверки данных врач появится в каталоге.
    </p>
    <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
      <strong>Важно:</strong> заявка уходит в Telegram владельцу каталога и сохраняется в открытом трекере
      GitHub. Указанный контакт (телефон, Telegram, email) и описание будут публичными. Добавляйте только
      данные, которые можно публиковать. Подробнее — <a href="/privacy/" class="underline">политика конфиденциальности</a>.
    </p>

    <form id="add-form" class="card p-6 mt-8 space-y-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="name">Имя и фамилия</label>
          <input id="name" name="name" class="input" required maxlength="120" placeholder="Мария Иванова" autocomplete="name" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="spec">Специальность</label>
          <input id="spec" name="spec" class="input" required maxlength="120" placeholder="Кардиолог" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="city">Город</label>
          <input id="city" name="city" class="input" required maxlength="60" placeholder="Belgrade" autocomplete="address-level2" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="exp">Стаж (лет)</label>
          <input id="exp" name="exp" type="number" min="0" max="70" class="input" placeholder="10" inputmode="numeric" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="clinic">Клиника / ординатура</label>
        <input id="clinic" name="clinic" class="input" maxlength="160" placeholder="Название, адрес" autocomplete="organization" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="contact">Контакт для связи</label>
        <input id="contact" name="contact" class="input" required maxlength="160" placeholder="Telegram / телефон / email" autocomplete="email" enterkeyhint="send" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="about">О враче</label>
        <textarea id="about" name="about" class="input min-h-28" maxlength="1500" placeholder="Образование, опыт, языки приёма…"></textarea>
      </div>

      <!-- honeypot -->
      <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
        <label for="website_trap">Website</label>
        <input id="website_trap" name="website_trap" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="flex items-start gap-2 text-sm text-slate-600">
        <input type="checkbox" name="consent" required class="mt-1 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        Понимаю, что заявка уйдёт боту в Telegram и будет сохранена публично в трекере GitHub; данные публичные,
        я имею право их передать; согласен с <a href="/privacy/" class="text-brand-700 underline">политикой конфиденциальности</a>.
      </label>

      <button type="submit" class="btn-primary w-full">Отправить заявку в Telegram</button>
      <p id="form-status" class="text-sm text-slate-500 hidden" role="status" aria-live="polite"></p>
      <p class="text-xs text-slate-400 text-center">
        Нет Telegram?
        <a id="github-fallback" href="https://github.com/rudoctors/rudoctors.github.io/issues/new?labels=doctor-request" target="_blank" rel="noopener noreferrer" class="underline">создайте заявку на GitHub</a>.
      </p>
    </form>

    <div class="mt-6 text-sm text-slate-500">
      Вопросы:
      <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">{SITE.telegramLabel}</a>
    </div>
  </div>
</Layout>

<script>
  import { isHoneypotFilled, cooldownRemainingMs, markSubmitted, formatCooldown } from "../lib/formGuard";
  import { SITE } from "../lib/site";

  const form = document.getElementById("add-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const KEY = "add-doctor";

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form) return;

    if (isHoneypotFilled(form)) {
      if (status) {
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = "Форма отправлена.";
      }
      return;
    }

    const wait = cooldownRemainingMs(KEY, 90_000);
    if (wait > 0) {
      if (status) {
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = formatCooldown(wait);
      }
      return;
    }

    const fd = new FormData(form);
    const name = String(fd.get("name") || "").trim();
    const spec = String(fd.get("spec") || "").trim();
    const city = String(fd.get("city") || "").trim();
    const exp = String(fd.get("exp") || "").trim();
    const clinic = String(fd.get("clinic") || "").trim();
    const contact = String(fd.get("contact") || "").trim();
    const about = String(fd.get("about") || "").trim();

    if (!name || !spec || !city || !contact) {
      if (status) {
        status.className = "text-sm mt-2 text-red-600";
        status.textContent = "Заполните обязательные поля без пустых пробелов.";
      }
      const missingField = !name ? "name" : !spec ? "spec" : !city ? "city" : "contact";
      document.getElementById(missingField)?.focus();
      return;
    }

    // Текст заявки: тот же формат полей, что разбирает бот (scripts/telegram-bot.mjs).
    const fields = [
      `Имя: ${name}`,
      `Специальность: ${spec}`,
      `Город: ${city}`,
      `Стаж: ${exp || "—"}`,
      `Клиника: ${clinic || "—"}`,
      `Контакт: ${contact}`,
    ];
    if (about) fields.push("", "О себе:", about);
    const tgText = `🩺 Заявка для каталога Rudoctors\n\n${fields.join("\n")}`;

    markSubmitted(KEY);
    if (status) {
      status.classList.remove("hidden");
      status.className = "text-sm mt-2 text-slate-500";
      status.textContent =
        "Открываем Telegram — нажмите «Отправить» в открывшемся чате, заявка сразу уйдёт владельцу.";
    }
    window.open(
      `https://t.me/${SITE.moderationBot}?text=${encodeURIComponent(tgText)}`,
      "_blank",
      "noopener,noreferrer"
    );
  });

  // Запасной путь без Telegram: предзаполненная GitHub Issue (нужно подтвердить Submit).
  document.getElementById("github-fallback")?.addEventListener("click", (e) => {
    const form = document.getElementById("add-form") as HTMLFormElement | null;
    if (!form) return;
    const get = (id: string) => String((form.elements.namedItem(id) as HTMLInputElement | null)?.value || "").trim();
    const name = get("name");
    const spec = get("spec");
    if (!name || !spec) return; // обычная ссылка, если поля пусты
    const body = [
      `**Имя:** ${name}`,
      `**Специальность:** ${spec}`,
      `**Город:** ${get("city")}`,
      `**Стаж:** ${get("exp") || "—"}`,
      `**Клиника:** ${get("clinic") || "—"}`,
      `**Контакт:** ${get("contact")}`,
      "",
      `**О себе:**`,
      get("about") || "—",
      "",
      "---",
      "_Создано через форму rudoctors.github.io_",
    ].join("\n");
    const url = `https://github.com/rudoctors/rudoctors.github.io/issues/new?title=${encodeURIComponent(
      `Новый врач: ${name} (${spec})`
    )}&body=${encodeURIComponent(body)}&labels=doctor-request`;
    e.preventDefault();
    window.open(url, "_blank", "noopener,noreferrer");
  });
</script>
