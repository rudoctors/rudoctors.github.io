---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../lib/site";
---

<Layout
  title="Добавить врача"
  description="Добавьте карточку русскоязычного врача в каталог Rudoctors."
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-navy-900">Добавить врача</h1>
    <p class="mt-2 text-slate-600">
      Карточку можно предложить бесплатно. Вы можете отправить заявку напрямую разработчику
      <a href={SITE.developerTelegram} target="_blank" rel="noopener noreferrer" class="text-brand-700 font-semibold hover:underline">{SITE.developerTelegramLabel}</a>,
      в бот модерации или скопировать готовые данные. После проверки данных карточка появится в каталоге.
    </p>

    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      <strong>Важно:</strong> указанные контакты (телефон, Telegram, клиника) и описание будут опубликованы открыто. Добавляйте только данные, на публикацию которых получено согласие врача или клиники. Подробнее — <a href="/privacy/" class="underline">политика конфиденциальности</a>.
    </div>

    <form id="add-form" class="card p-6 mt-6 space-y-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="name">Имя и фамилия врача</label>
          <input id="name" name="name" class="input" required maxlength="120" placeholder="Мария Иванова" autocomplete="name" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="spec">Специальность</label>
          <input id="spec" name="spec" class="input" required maxlength="120" placeholder="Кардиолог" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-1" for="city">Город приёма</label>
          <input id="city" name="city" class="input" required maxlength="60" placeholder="Belgrade" autocomplete="address-level2" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="exp">Стаж (лет)</label>
          <input id="exp" name="exp" type="number" min="0" max="70" class="input" placeholder="10" inputmode="numeric" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="clinic">Клиника / кабинет / адрес</label>
        <input id="clinic" name="clinic" class="input" maxlength="160" placeholder="Название клиники, адрес или район" autocomplete="organization" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="contact">Публичный контакт для записи</label>
        <input id="contact" name="contact" class="input" required maxlength="160" placeholder="Telegram @username, телефон +381... или сайт" autocomplete="email" enterkeyhint="send" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1" for="about">О враче и опыт</label>
        <textarea id="about" name="about" class="input min-h-28" maxlength="1500" placeholder="Образование, опыт, направления работы, языки приёма…"></textarea>
      </div>

      <!-- honeypot -->
      <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
        <label for="website_trap">Website</label>
        <input id="website_trap" name="website_trap" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="flex items-start gap-2 text-sm text-slate-600">
        <input type="checkbox" name="consent" required class="mt-1 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        Подтверждаю, что передаваемые данные являются публичными; согласен с
        <a href="/privacy/" class="text-brand-700 underline">политикой конфиденциальности</a>.
      </label>

      <button type="submit" class="btn-primary w-full !py-3 font-bold text-base">
        Сформировать и отправить заявку
      </button>
      <p id="form-status" class="text-sm text-slate-500 hidden" role="status" aria-live="polite"></p>
    </form>

    <!-- Success / Action Box (hidden by default) -->
    <div id="add-success-box" class="card p-6 mt-6 border-2 border-emerald-200 bg-emerald-50/40 hidden space-y-4">
      <div class="flex items-center gap-2 text-emerald-800 font-extrabold text-lg">
        <svg class="w-6 h-6 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span id="add-success-title">Заявка отправлена на модерацию!</span>
      </div>
      <p id="add-success-copy" class="text-sm text-slate-700">
        Модератор получит заявку и проверит данные перед публикацией.
      </p>

      <div class="flex flex-wrap gap-2.5 pt-1">
        <a
          id="btn-add-tg-dev"
          href={SITE.developerTelegram}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary !bg-sky-600 hover:!bg-sky-700 inline-flex items-center gap-1.5"
        >
          <span>Написать разработчику ({SITE.developerTelegramLabel})</span>
        </a>

        <a
          id="btn-add-tg-share"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary inline-flex items-center gap-1.5"
        >
          <span>Поделиться в Telegram</span>
        </a>

        <button
          type="button"
          id="btn-copy-add"
          class="btn-secondary inline-flex items-center gap-1.5"
        >
          <span id="btn-copy-add-text">Скопировать заявку</span>
        </button>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1" for="add-preview">Готовый текст заявки:</label>
        <textarea
          id="add-preview"
          readonly
          class="input bg-white text-xs font-mono min-h-32 text-slate-700 select-all"></textarea>
      </div>

      <div class="pt-2 text-xs text-slate-500 border-t border-emerald-200/60">
        У вас есть аккаунт на GitHub? Вы также можете
        <a id="btn-add-github-issue" href="#" target="_blank" rel="noopener noreferrer" class="text-brand-700 underline font-medium">создать заявку на GitHub</a>.
      </div>
    </div>

    <div class="mt-8 flex items-center justify-between text-sm text-slate-500 border-t border-slate-200 pt-6">
      <div>
        Разработчик: <a href={SITE.developerTelegram} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline font-medium">{SITE.developerTelegramLabel}</a>
      </div>
      <div>
        Сообщество: <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline font-medium">{SITE.telegramLabel}</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { isHoneypotFilled, cooldownRemainingMs, markSubmitted, formatCooldown } from "../lib/formGuard";
  import { SITE } from "../lib/site";

  const form = document.getElementById("add-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const successBox = document.getElementById("add-success-box");
  const previewArea = document.getElementById("add-preview") as HTMLTextAreaElement | null;
  const btnTgDev = document.getElementById("btn-add-tg-dev") as HTMLAnchorElement | null;
  const btnTgShare = document.getElementById("btn-add-tg-share") as HTMLAnchorElement | null;
  const btnCopy = document.getElementById("btn-copy-add");
  const btnCopyText = document.getElementById("btn-copy-add-text");
  const btnGithub = document.getElementById("btn-add-github-issue") as HTMLAnchorElement | null;
  const successTitle = document.getElementById("add-success-title");
  const successCopy = document.getElementById("add-success-copy");
  const KEY = "add-doctor";
  const DOCTOR_WEBHOOK_URL = import.meta.env.PUBLIC_DOCTOR_WEBHOOK_URL?.trim() || "";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;

    if (isHoneypotFilled(form)) {
      if (status) {
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = "Форма отправлена.";
      }
      return;
    }

    const wait = cooldownRemainingMs(KEY, 30_000);
    if (wait > 0) {
      if (status) {
        status.classList.remove("hidden");
        status.className = "text-sm mt-2 text-slate-500";
        status.textContent = formatCooldown(wait);
      }
      return;
    }

    const fd = new FormData(form);
    const name = String(fd.get("name") || "").trim();
    const spec = String(fd.get("spec") || "").trim();
    const city = String(fd.get("city") || "").trim();
    const exp = String(fd.get("exp") || "").trim();
    const clinic = String(fd.get("clinic") || "").trim();
    const contact = String(fd.get("contact") || "").trim();
    const about = String(fd.get("about") || "").trim();

    if (!name || !spec || !city || !contact) {
      if (status) {
        status.classList.remove("hidden");
        status.className = "text-sm mt-2 text-red-600";
        status.textContent = "Заполните обязательные поля (имя, специальность, город, контакт).";
      }
      const missingField = !name ? "name" : !spec ? "spec" : !city ? "city" : "contact";
      document.getElementById(missingField)?.focus();
      return;
    }

    const fields = [
      `🩺 Заявка для каталога Rudoctors`,
      ``,
      `Имя: ${name}`,
      `Специальность: ${spec}`,
      `Город: ${city}`,
      `Стаж: ${exp ? exp + " лет" : "—"}`,
      `Клиника / кабинет: ${clinic || "—"}`,
      `Контакт для записи: ${contact}`,
    ];
    if (about) {
      fields.push(``, `О враче:`, about);
    }
    fields.push(``, `---`, `Отправлено через rudoctors.github.io/add-doctor/`);

    const tgText = fields.join("\n");

    if (previewArea) {
      previewArea.value = tgText;
    }

    // Telegram share URL
    const shareUrl = `https://t.me/share/url?url=${encodeURIComponent("https://rudoctors.github.io")}&text=${encodeURIComponent(tgText)}`;
    if (btnTgShare) {
      btnTgShare.href = shareUrl;
    }

    // Direct developer Telegram
    if (btnTgDev) {
      btnTgDev.href = `${SITE.developerTelegram}?text=${encodeURIComponent(tgText)}`;
    }

    // GitHub fallback
    const ghUrl = `https://github.com/rudoctors/rudoctors.github.io/issues/new?title=${encodeURIComponent(
      `Новый врач: ${name} (${spec})`
    )}&body=${encodeURIComponent(tgText)}&labels=doctor-request`;
    if (btnGithub) {
      btnGithub.href = ghUrl;
    }

    const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const defaultButtonText = submitButton?.textContent || "Сформировать и отправить заявку";
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Отправляем…";
    }
    if (status) {
      status.classList.remove("hidden");
      status.className = "text-sm mt-2 text-slate-500";
      status.textContent = "Отправляем заявку на модерацию…";
    }

    try {
      if (!DOCTOR_WEBHOOK_URL) {
        throw new Error("doctor webhook is not configured");
      }
      const response = await fetch(DOCTOR_WEBHOOK_URL, {
        method: "POST",
        // A simple request avoids an Apps Script CORS preflight.
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({
          name,
          spec,
          city,
          exp,
          clinic,
          contact,
          about,
          website_hp: String(fd.get("website_trap") || ""),
        }),
      });
      const result = await response.json().catch(() => ({ ok: false }));
      if (!response.ok || result.ok !== true || !Number.isInteger(result.issue)) {
        throw new Error("request failed");
      }

      markSubmitted(KEY);
      form.reset();
      if (status) status.classList.add("hidden");
      if (successTitle) successTitle.textContent = "Заявка отправлена на модерацию!";
      if (successCopy) successCopy.textContent = `Заявка №${result.issue} передана модератору. Мы проверим данные перед публикацией.`;
      if (successBox) {
        successBox.classList.remove("hidden");
        successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    } catch {
      if (status) {
        status.className = "text-sm mt-2 text-red-600";
        status.textContent = "Не удалось отправить заявку автоматически. Используйте один из способов ниже.";
      }
      if (successTitle) successTitle.textContent = "Автоматическая отправка недоступна";
      if (successCopy) successCopy.textContent = "Передайте уже заполненную заявку через Telegram, копирование или GitHub — данные в форме сохранены.";
      if (successBox) {
        successBox.classList.remove("hidden");
        successBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = defaultButtonText;
      }
    }
  });

  // Copy to clipboard handler
  btnCopy?.addEventListener("click", async () => {
    if (!previewArea) return;
    try {
      await navigator.clipboard.writeText(previewArea.value);
      if (btnCopyText) {
        const orig = btnCopyText.textContent;
        btnCopyText.textContent = "Скопировано!";
        setTimeout(() => {
          btnCopyText.textContent = orig;
        }, 3000);
      }
    } catch {
      previewArea.select();
      document.execCommand("copy");
      if (btnCopyText) btnCopyText.textContent = "Скопировано!";
    }
  });
</script>
