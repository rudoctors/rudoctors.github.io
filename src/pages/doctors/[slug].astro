---
import Layout from "../../layouts/Layout.astro";
import Stars from "../../components/Stars.astro";
import { publicDoctors, specLabel } from "../../lib/doctors";
import { computeRating } from "../../lib/rating";
import { SITE, formatDate, plural } from "../../lib/site";
import type { Doctor } from "../../lib/types";

export function getStaticPaths() {
  return publicDoctors().map((doctor) => ({
    params: { slug: doctor.slug },
    props: { doctor },
  }));
}

interface Props {
  doctor: Doctor;
}

const { doctor } = Astro.props;
const rating = computeRating(doctor);
const initials = doctor.name
  .split(/\s+/)
  .slice(0, 2)
  .map((p) => p[0])
  .join("")
  .toUpperCase();

const related = publicDoctors()
  .filter((d) => d.slug !== doctor.slug && d.specializations.some((s) => doctor.specializations.includes(s)))
  .slice(0, 3);

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Physician",
    name: doctor.name,
    url: `${SITE.url}/doctors/${doctor.slug}/`,
    medicalSpecialty: doctor.specializations.map((s) => specLabel(s)),
    address: doctor.workplaces[0]?.address
      ? {
          "@type": "PostalAddress",
          streetAddress: doctor.workplaces[0].address,
          addressLocality: doctor.workplaces[0].city || doctor.city,
          addressCountry: "RS",
        }
      : undefined,
    telephone: doctor.contacts.phone || undefined,
    image: doctor.photo || undefined,
    aggregateRating:
      rating.count > 0
        ? {
            "@type": "AggregateRating",
            ratingValue: rating.average,
            reviewCount: rating.count,
            bestRating: 5,
          }
        : undefined,
  },
];
---

<Layout
  title={doctor.name}
  description={`${doctor.name} — ${doctor.specializations.map(specLabel).join(", ")} в ${doctor.city}. Рейтинг, отзывы, опыт и контакты.`}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav class="text-sm text-slate-500 mb-6 flex flex-wrap gap-2">
      <a href="/" class="hover:text-brand-700">Главная</a>
      <span>/</span>
      <a href="/doctors/" class="hover:text-brand-700">Врачи</a>
      <span>/</span>
      <span class="text-slate-800">{doctor.name}</span>
    </nav>

    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Main -->
      <div class="lg:col-span-2 space-y-6">
        <div class="card p-6 md:p-7">
          <div class="flex flex-col sm:flex-row gap-5">
            <div class="shrink-0 mx-auto sm:mx-0">
              {
                doctor.photo ? (
                  <img
                    src={doctor.photo}
                    alt={doctor.name}
                    width={128}
                    height={128}
                    class="h-28 w-28 md:h-32 md:w-32 rounded-3xl object-cover bg-slate-100"
                  />
                ) : (
                  <div class="h-28 w-28 md:h-32 md:w-32 rounded-3xl bg-brand-100 text-brand-800 flex items-center justify-center font-extrabold text-3xl">
                    {initials}
                  </div>
                )
              }
            </div>

            <div class="min-w-0 flex-1 text-center sm:text-left">
              <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                {doctor.featured && (
                  <span class="text-[11px] font-bold uppercase tracking-wide px-2 py-0.5 rounded-full bg-accent-400/15 text-accent-500">
                    Рекомендуем
                  </span>
                )}
                <h1 class="text-2xl md:text-3xl font-extrabold text-navy-900">{doctor.name}</h1>
              </div>

              {doctor.nameEn && <p class="text-sm text-slate-500 mt-1">{doctor.nameEn}</p>}

              <div class="mt-3 flex flex-wrap justify-center sm:justify-start gap-1.5">
                {doctor.specializations.map((s) => (
                  <a href={`/specialties/${s}/`} class="chip hover:bg-brand-100">
                    {specLabel(s)}
                  </a>
                ))}
              </div>

              <div class="mt-4 flex flex-wrap justify-center sm:justify-start items-center gap-4">
                <Stars rating={rating.average} count={rating.count} />
                {doctor.experienceYears ? (
                  <span class="text-sm text-slate-600">Стаж {doctor.experienceYears} {plural(doctor.experienceYears, "год", "года", "лет")}</span>
                ) : null}
              </div>

              <div class="mt-3 text-sm text-slate-600">
                {[doctor.city, doctor.district].filter(Boolean).join(" · ")}
              </div>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-2 justify-center sm:justify-start">
            {
              doctor.contacts.appointmentUrl && (
                <a href={doctor.contacts.appointmentUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
                  Записаться
                </a>
              )
            }
            {
              doctor.contacts.phone && (
                <a href={`tel:${doctor.contacts.phone.replace(/\s/g, "")}`} class="btn-secondary">
                  {doctor.contacts.phone}
                </a>
              )
            }
            {
              doctor.contacts.telegram && (
                <a href={doctor.contacts.telegram} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                  Telegram
                </a>
              )
            }
            {
              doctor.contacts.website && (
                <a href={doctor.contacts.website} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                  Сайт
                </a>
              )
            }
            <a href={`/leave-review/?doctor=${doctor.slug}`} class="btn-ghost">
              Оставить отзыв
            </a>
          </div>

          <div class="mt-4 flex flex-wrap gap-2 justify-center sm:justify-start text-xs text-slate-500">
            <span class="px-2 py-1 rounded-md bg-slate-100">Языки: {doctor.languages.map((l) => l.toUpperCase()).join(", ")}</span>
            {doctor.formats.map((f) => (
              <span class="px-2 py-1 rounded-md bg-slate-100">{f === "online" ? "Онлайн" : "Очно"}</span>
            ))}
          </div>
        </div>

        {
          doctor.bio && (
            <section class="card p-6" id="about">
              <h2 class="text-lg font-extrabold text-navy-900 mb-3">О враче</h2>
              <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-[15px] whitespace-pre-line">
                {doctor.bio.replace(/<[^>]+>/g, "\n").replace(/\n{3,}/g, "\n\n").trim()}
              </div>
            </section>
          )
        }

        <section class="card p-6" id="reviews">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-extrabold text-navy-900">
              Отзывы
              {rating.count > 0 && <span class="text-slate-400 font-semibold">({rating.count})</span>}
            </h2>
            <a href={`/leave-review/?doctor=${doctor.slug}`} class="text-sm text-brand-700 font-semibold hover:underline">
              + Добавить
            </a>
          </div>

          {
            rating.count === 0 ? (
              <div class="rounded-2xl bg-slate-50 border border-dashed border-slate-200 p-6 text-center">
                <p class="text-slate-600">Отзывов пока нет.</p>
                <p class="text-sm text-slate-500 mt-1">Если вы были у этого врача — поделитесь впечатлением.</p>
                <a href={`/leave-review/?doctor=${doctor.slug}`} class="btn-primary mt-4">
                  Написать первый отзыв
                </a>
              </div>
            ) : (
              <ul class="space-y-4">
                {[...(doctor.reviews || [])]
                  .sort((a, b) => (b.date || "").localeCompare(a.date || ""))
                  .map((r) => (
                    <li class="rounded-2xl border border-slate-200 p-4 bg-white">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="font-semibold text-slate-900">{r.author || "Пациент"}</div>
                        <div class="text-xs text-slate-500">{r.date ? formatDate(r.date) : ""}</div>
                      </div>
                      <div class="mt-1 text-amber-400 text-sm" aria-label={`${r.rating} из 5`}>
                        {"★".repeat(Math.round(r.rating || 5))}
                        <span class="text-slate-300">{"★".repeat(5 - Math.round(r.rating || 5))}</span>
                      </div>
                      <p class="mt-2 text-sm text-slate-700 leading-relaxed whitespace-pre-line">{r.text}</p>
                      {r.source && <div class="mt-2 text-[11px] text-slate-400">Источник: {r.source}</div>}
                    </li>
                  ))}
              </ul>
            )
          }
        </section>

        {
          doctor.education.length > 0 && (
            <section class="card p-6">
              <h2 class="text-lg font-extrabold text-navy-900 mb-3">Образование</h2>
              <ul class="space-y-3">
                {doctor.education.map((e) => (
                  <li class="flex flex-col sm:flex-row sm:gap-3 text-sm">
                    <div class="sm:w-28 text-slate-500 shrink-0">{e.years || ""}</div>
                    <div>
                      <div class="font-medium text-slate-800">{e.degree}</div>
                      {e.institution && <div class="text-slate-500">{e.institution}</div>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="card p-5">
          <h2 class="font-bold text-navy-900 mb-3">Места приёма</h2>
          {
            doctor.workplaces.length === 0 ? (
              <p class="text-sm text-slate-500">Клиника не указана.</p>
            ) : (
              <ul class="space-y-4">
                {doctor.workplaces.map((w) => (
                  <li class="text-sm">
                    <div class="font-semibold text-slate-900">{w.clinic}</div>
                    {w.address && <div class="text-slate-600 mt-0.5">{w.address}</div>}
                    {w.city && <div class="text-slate-500">{[w.city, w.district].filter(Boolean).join(", ")}</div>}
                    <div class="mt-2 flex flex-wrap gap-2">
                      {w.url && (
                        <a href={w.url} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline text-xs font-semibold">
                          Сайт клиники
                        </a>
                      )}
                      {(w.mapsUrl || doctor.contacts.mapsUrl) && (
                        <a
                          href={w.mapsUrl || doctor.contacts.mapsUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-brand-700 hover:underline text-xs font-semibold"
                        >
                          Карта
                        </a>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="card p-5">
          <h2 class="font-bold text-navy-900 mb-3">Контакты</h2>
          <ul class="space-y-2 text-sm">
            {doctor.contacts.phone && (
              <li>
                <span class="text-slate-500">Телефон: </span>
                <a class="text-brand-700 font-medium hover:underline" href={`tel:${doctor.contacts.phone.replace(/\s/g, "")}`}>
                  {doctor.contacts.phone}
                </a>
              </li>
            )}
            {doctor.contacts.email && (
              <li>
                <span class="text-slate-500">Email: </span>
                <a class="text-brand-700 font-medium hover:underline" href={`mailto:${doctor.contacts.email}`}>
                  {doctor.contacts.email}
                </a>
              </li>
            )}
            {doctor.contacts.telegram && (
              <li>
                <span class="text-slate-500">Telegram: </span>
                <a class="text-brand-700 font-medium hover:underline" href={doctor.contacts.telegram} target="_blank" rel="noopener noreferrer">
                  открыть
                </a>
              </li>
            )}
          </ul>
          {
            doctor.sources.length > 0 && (
              <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400">
                Источники: {doctor.sources.join(", ")}
              </div>
            )
          }
          <div class="mt-3 text-[11px] text-slate-400">
            Обновлено: {doctor.updatedAt ? formatDate(doctor.updatedAt) : "—"}
          </div>
        </div>

        <div class="card p-5 bg-brand-50 border-brand-100">
          <div class="text-xs font-bold uppercase tracking-wide text-brand-700">Сообщество</div>
          <p class="mt-2 text-sm text-slate-700">
            Обсуждение врачей в чате {SITE.telegramLabel}
          </p>
          <a href={SITE.telegram} target="_blank" rel="noopener noreferrer" class="btn-primary mt-3 w-full">
            Открыть чат
          </a>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xl font-extrabold text-navy-900 mb-4">Похожие специалисты</h2>
          <div class="grid gap-4 md:grid-cols-3">
            {related.map((r) => (
              <a href={`/doctors/${r.slug}/`} class="card p-4 hover:border-brand-300 transition block">
                <div class="font-bold text-navy-900">{r.name}</div>
                <div class="text-sm text-slate-600 mt-1">{r.specializations.map(specLabel).join(", ")}</div>
                <div class="text-xs text-slate-500 mt-2">{r.city}</div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
