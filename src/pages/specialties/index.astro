---
import Layout from "../../layouts/Layout.astro";
import { allSpecializationKeys, publicDoctors, specLabel } from "../../lib/doctors";
import { computeRating } from "../../lib/rating";
import { plural } from "../../lib/site";

const keys = allSpecializationKeys();
const withCounts = keys.map((k) => {
  const docs = publicDoctors().filter((d) => d.specializations.includes(k));
  const ratings = docs.map((d) => computeRating(d)).filter((r) => r.average > 0);
  const avg = ratings.length
    ? Math.round((ratings.reduce((s, r) => s + r.average, 0) / ratings.length) * 10) / 10
    : 0;
  const reviewsCount = docs.reduce((sum, d) => sum + (d.reviews?.length || 0), 0);
  return {
    key: k,
    label: specLabel(k),
    count: docs.length,
    avg,
    reviewsCount,
  };
});
---

<Layout
  title="Медицинские специальности — врачи в Сербии"
  description="Каталог врачей по специальностям в Сербии: стоматологи, педиатры, гинекологи, неврологи, терапевты. Рейтинги, проверенные отзывы пациентов и контакты для записи."
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Специальности", path: "/specialties/" },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-extrabold text-navy-900">Специальности</h1>
    <p class="mt-2 text-slate-600">
      Выберите направление — увидите рейтинг врачей и отзывы. Страница специальности помогает сравнить опыт, клиники и города приёма до записи.
    </p>
    <p class="mt-2 text-slate-600">
      Рейтинг складывается из оценок пациентов: количество, свежесть и детальность отзыва. Отзывы проходят модерацию.
      Каталог независим — врачи не могут купить место выше. Перед записью сверьте данные в клинике и официальном реестре, языки приёма и формат (очно или онлайн).
      Если нужен врач определённой специальности, откройте карточку, проверьте клинику и свяжитесь с врачом по публичным контактам.
      Список обновляется вместе с карточками; предложения по новым врачам принимаются через
      <a href="/add-doctor/" class="text-brand-700 hover:underline">форму добавления</a>.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        withCounts.map((s) => (
          <a href={`/specialties/${s.key}/`} class="card p-5 hover:border-brand-300 transition group">
            <div class="flex items-start justify-between gap-3">
              <h2 class="font-bold text-navy-900 group-hover:text-brand-700">{s.label}</h2>
              <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2 py-1 rounded-lg shrink-0">
                {s.count}
              </span>
            </div>
            <div class="mt-2 text-sm text-slate-500">
              {s.avg > 0 ? (
                `Средний рейтинг ${s.avg}`
              ) : s.reviewsCount > 0 ? (
                `${s.reviewsCount} ${plural(s.reviewsCount, "отзыв", "отзыва", "отзывов")}`
              ) : (
                `${s.count} ${plural(s.count, "специалист", "специалиста", "специалистов")}`
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
