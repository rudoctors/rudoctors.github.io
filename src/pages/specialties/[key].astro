---
import Layout from "../../layouts/Layout.astro";
import DoctorCard from "../../components/DoctorCard.astro";
import { allSpecializationKeys, publicDoctors, specLabel } from "../../lib/doctors";
import { cityLabel, citySlug, SITE } from "../../lib/site";
import intros from "../../data/specialty-intros.json";

export function getStaticPaths() {
  return allSpecializationKeys().map((key) => ({
    params: { key },
    props: { key },
  }));
}

interface Props {
  key: string;
}

const { key } = Astro.props;
const label = specLabel(key);
const doctors = publicDoctors().filter((d) => d.specializations.includes(key));
const PAGE_SIZE = 24;
const visibleDoctors = doctors.slice(0, PAGE_SIZE);
const hasMore = doctors.length > PAGE_SIZE;

const map = intros as Record<string, string>;
const intro =
  map[key] ||
  `Русскоязычные врачи-специалисты «${label.toLowerCase()}» в Сербии: рейтинги, отзывы пациентов, опыт и контакты. ${doctors.length} ${doctors.length === 1 ? "карточка" : doctors.length < 5 ? "карточки" : "карточек"} в каталоге — Белград, Нови-Сад и другие города.`;
const citiesPresent = [...new Set(doctors.map((d) => d.city))];
const faqLine =
  citiesPresent.length > 0
    ? `Консультации специалистов по направлению «${label}» доступны в городах: ${citiesPresent.map(cityLabel).join(", ")}.`
    : `Карточки специалистов «${label}» появляются в каталоге по мере проверки данных.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${label} в Сербии`,
    url: `${SITE.url}/specialties/${key}/`,
    description: `Русскоязычные врачи и специалисты «${label.toLowerCase()}» в Сербии: проверенные клиники, рейтинг, отзывы пациентов и прямые контакты.`,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: doctors.length,
      itemListElement: visibleDoctors.map((d, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        url: `${SITE.url}/doctors/${d.slug}/`,
        name: d.name,
      })),
    },
  },
];
---

<Layout
  title={`${label} в Сербии (Белград, Нови-Сад) — русскоязычные врачи, отзывы`}
  description={`Русскоязычные врачи и специалисты «${label.toLowerCase()}» в Сербии: проверенные клиники, рейтинг, отзывы пациентов и прямые контакты для связи. Карточки врачей в Белграде и Нови-Саде.`}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Специальности", path: "/specialties/" },
    { name: label, path: `/specialties/${key}/` },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/specialties/" class="hover:text-brand-700">Специальности</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800">{label}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-extrabold text-navy-900">{label}</h1>
    <p class="mt-2 text-slate-600">
      {doctors.length} {doctors.length === 1 ? "врач" : doctors.length < 5 ? "врача" : "врачей"} в каталоге
    </p>
    <div class="mt-4 max-w-3xl text-slate-700 leading-relaxed space-y-3">
      <p>{intro}</p>
      <p class="text-sm text-slate-500">{faqLine}</p>
    </div>
    <p class="mt-3 text-sm">
      <a href="/faq/" class="text-brand-700 hover:underline">Как выбрать врача в Сербии → FAQ</a>
    </p>

    {
      citiesPresent.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2 items-center text-xs">
          <span class="font-semibold text-slate-500 uppercase tracking-wide mr-1">По городам:</span>
          {citiesPresent.map((c) => (
            <a href={`/cities/${citySlug(c)}/${key}/`} class="chip hover:bg-brand-50 hover:text-brand-700 hover:border-brand-300">
              {cityLabel(c)} · {doctors.filter((d) => d.city === c).length}
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <a href={`/doctors/?spec=${key}`} class="chip bg-brand-50 text-brand-700 font-semibold ring-1 ring-brand-600/20">
        Все «{label}» ({doctors.length})
      </a>
      {doctors.some((d) => d.origin === "rs") && (
        <a href={`/doctors/?spec=${key}&origin=rs`} class="chip bg-rose-50 text-rose-700 hover:bg-rose-100 font-semibold ring-1 ring-rose-600/20 flex items-center gap-1 transition">
          <span aria-hidden="true">🇷🇸</span>
          <span>Сербские врачи ({doctors.filter((d) => d.origin === "rs").length})</span>
        </a>
      )}
      {doctors.some((d) => d.origin !== "rs") && (
        <a href={`/doctors/?spec=${key}&origin=ru`} class="chip hover:bg-slate-200 transition">
          Русскоязычные врачи ({doctors.filter((d) => d.origin !== "rs").length})
        </a>
      )}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {visibleDoctors.map((d, index) => <DoctorCard doctor={d} priority={index < 3} />)}
    </div>

    {
      hasMore && (
        <div class="mt-8 p-6 rounded-2xl bg-gradient-to-r from-brand-50/50 via-slate-50 to-brand-50/30 border border-brand-200/80 text-center">
          <p class="text-sm font-medium text-slate-700 mb-3">
            Показаны первые {PAGE_SIZE} специалистов из {doctors.length} по направлению «{label}».
          </p>
          <a
            href={`/doctors/?spec=${key}`}
            class="btn-primary inline-flex items-center gap-2 !py-2.5 !px-5 text-sm shadow-sm"
          >
            <span>Смотреть всех врачей ({doctors.length}) в каталоге с фильтрами</span>
            <span>→</span>
          </a>
        </div>
      )
    }

    {
      doctors.length === 0 && (
        <div class="card p-10 text-center text-slate-500 mt-6">
          В этой специальности пока нет карточек.
          <a href="/add-doctor/" class="text-brand-700 font-semibold hover:underline ml-1">Добавить врача</a>
        </div>
      )
    }
  </div>
</Layout>
