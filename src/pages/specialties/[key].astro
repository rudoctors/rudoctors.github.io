---
import Layout from "../../layouts/Layout.astro";
import DoctorCard from "../../components/DoctorCard.astro";
import { allSpecializationKeys, publicDoctors, specLabel } from "../../lib/doctors";
import intros from "../../data/specialty-intros.json";

export function getStaticPaths() {
  return allSpecializationKeys().map((key) => ({
    params: { key },
    props: { key },
  }));
}

interface Props {
  key: string;
}

const { key } = Astro.props;
const label = specLabel(key);
const doctors = publicDoctors().filter((d) => d.specializations.includes(key));
const map = intros as Record<string, string>;
const intro =
  map[key] ||
  `Русскоязычные врачи-специалисты «${label.toLowerCase()}» в Сербии: рейтинги, отзывы пациентов, опыт и контакты. ${doctors.length} ${doctors.length === 1 ? "карточка" : doctors.length < 5 ? "карточки" : "карточек"} в каталоге — Белград, Нови-Сад и другие города.`;
const citiesPresent = [...new Set(doctors.map((d) => d.city))];
const faqLine =
  citiesPresent.length > 0
    ? `Запись к врачу-специалисту «${label}» возможна в: ${citiesPresent.join(", ")}.`
    : `Карточки специалистов «${label}» появляются в каталоге по мере проверки данных.`;
---

<Layout
  title={`${label} в Сербии`}
  description={`Русскоязычные врачи-${label.toLowerCase()} в Сербии: рейтинг, отзывы, контакты и запись. ${doctors.length} карточек — Белград, Нови-Сад.`}
  breadcrumbs={[
    { name: "Главная", path: "/" },
    { name: "Специальности", path: "/specialties/" },
    { name: label, path: `/specialties/${key}/` },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/specialties/" class="hover:text-brand-700">Специальности</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800">{label}</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-extrabold text-navy-900">{label}</h1>
    <p class="mt-2 text-slate-600">
      {doctors.length} {doctors.length === 1 ? "врач" : doctors.length < 5 ? "врача" : "врачей"} в каталоге
    </p>
    <div class="mt-4 max-w-3xl text-slate-700 leading-relaxed space-y-3">
      <p>{intro}</p>
      <p class="text-sm text-slate-500">{faqLine}</p>
    </div>
    <p class="mt-3 text-sm">
      <a href="/faq/" class="text-brand-700 hover:underline">Как выбрать врача в Сербии → FAQ</a>
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {doctors.map((d) => <DoctorCard doctor={d} />)}
    </div>

    {
      doctors.length === 0 && (
        <div class="card p-10 text-center text-slate-500 mt-6">
          В этой специальности пока нет карточек.
          <a href="/add-doctor/" class="text-brand-700 font-semibold hover:underline ml-1">Добавить врача</a>
        </div>
      )
    }
  </div>
</Layout>
