---
import type { Doctor } from "../lib/types";
import { computeRating } from "../lib/rating";
import { specLabel } from "../lib/doctors";
import { cityLabel } from "../lib/site";
import Stars from "./Stars.astro";

interface Props {
  doctor: Doctor;
  priority?: boolean;
}
const { doctor, priority = false } = Astro.props;
const rating = computeRating(doctor);
const initials = doctor.name
  .split(/\s+/)
  .slice(0, 2)
  .map((p) => p[0])
  .join("")
  .toUpperCase();
const photo = doctor.photo;

function decodeHtml(str: string): string {
  return str
    .replace(/<[^>]+>/g, " ")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&nbsp;/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

const cleanBio = doctor.bio ? decodeHtml(doctor.bio) : "";
---

<article class="card p-5 flex flex-col gap-3.5">
  <div class="flex gap-4 items-start">
    <div class="shrink-0">
      {
        photo ? (
          <img
            src={photo}
            alt={doctor.name}
            width={72}
            height={72}
            loading={priority ? "eager" : "lazy"}
            fetchpriority={priority ? "high" : "auto"}
            class="h-16 w-16 rounded-2xl object-cover object-top bg-slate-100 ring-1 ring-slate-900/5 shadow-xs"
          />
        ) : (
          <div class="h-16 w-16 rounded-2xl bg-teal-50 text-teal-800 ring-1 ring-teal-600/10 flex items-center justify-center font-bold text-lg select-none">
            {initials}
          </div>
        )
      }
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-col gap-0.5">
        <div class="flex items-center gap-2 flex-wrap">
          <a
            href={`/doctors/${doctor.slug}/`}
            class="font-bold text-lg text-navy-900 hover:text-brand-700 leading-snug line-clamp-2"
          >
            {doctor.name}
          </a>
          {doctor.featured && <span class="badge-new">Выделено</span>}
        </div>
        <div class="text-xs text-slate-500">
          {[cityLabel(doctor.city), doctor.district].filter(Boolean).join(" · ")}
          {doctor.experienceYears ? ` · стаж ${doctor.experienceYears} лет` : ""}
        </div>
      </div>

      <div class="mt-2 flex flex-wrap gap-1.5">
        {doctor.specializations.slice(0, 3).map((s) => (
          <span class="chip">{specLabel(s)}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-slate-500">
    <Stars rating={rating.average} count={rating.ratedCount} textCount={rating.count - rating.ratedCount} size="sm" />
  </div>

  {
    cleanBio && (
      <p class="text-sm text-slate-600 line-clamp-2 leading-relaxed">{cleanBio}</p>
    )
  }

  <div class="mt-auto flex items-center justify-between gap-3 pt-2.5 border-t border-slate-100">
    <div class="flex flex-wrap gap-1.5 text-xs text-slate-500 min-w-0">
      {doctor.languages.slice(0, 4).map((l) => (
        <span class="px-2 py-0.5 rounded-md bg-slate-100">{l.toUpperCase()}</span>
      ))}
      {doctor.formats.includes("online") && <span class="chip">Онлайн</span>}
      {doctor.formats.includes("offline") && (
        <span class="px-2 py-0.5 rounded-md bg-slate-100">Очно</span>
      )}
    </div>
    <a
      href={`/doctors/${doctor.slug}/`}
      class="btn-secondary !py-1.5 !px-3 text-xs whitespace-nowrap shrink-0"
      aria-label={`Профиль: ${doctor.name}`}
    >
      Профиль →
    </a>
  </div>
</article>
