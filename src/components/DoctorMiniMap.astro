---
import type { DoctorMapLocation } from "../lib/clinics";

interface Props {
  locations: DoctorMapLocation[];
  doctorName?: string;
}

const { locations } = Astro.props;
if (!locations || locations.length === 0) return null;

const initialLocation = locations[0];
---

<div class="doctor-mini-map-root mt-4 pt-4 border-t border-slate-100">
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />

  <div class="flex items-center justify-between gap-2 mb-2">
    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
      Локация на карте
    </span>
    {
      locations.length > 1 && (
        <span class="text-[11px] font-semibold text-brand-700 bg-brand-50 px-2 py-0.5 rounded-full border border-brand-100">
          {locations.length} филиала
        </span>
      )
    }
  </div>

  {
    locations.length > 1 && (
      <div class="flex items-center gap-1.5 overflow-x-auto pb-2 mb-2">
        {locations.map((loc, idx) => (
          <button
            type="button"
            class:list={[
              "btn-mini-map-tab px-2.5 py-1 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer",
              idx === 0
                ? "bg-brand-600 text-white shadow-xs"
                : "bg-slate-100 text-slate-600 hover:bg-slate-200",
            ]}
            data-index={idx}
          >
            {loc.district || loc.clinicName.replace(/клиника/i, "").trim() || `Филиал ${idx + 1}`}
          </button>
        ))}
      </div>
    )
  }

  <!-- Map Canvas -->
  <div class="relative w-full h-48 sm:h-52 rounded-xl overflow-hidden border border-slate-200 shadow-inner bg-slate-100">
    <div id="doctor-mini-leaflet-map" class="w-full h-full z-10"></div>
  </div>

  <!-- Active Location Info & Action Buttons -->
  <div class="mt-2.5 space-y-2">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0 flex-1">
        <h4 id="mini-map-clinic-name" class="text-xs font-bold text-slate-900 leading-snug">
          {initialLocation.clinicName}
        </h4>
        <p id="mini-map-address" class="text-[11px] text-slate-500 mt-0.5 truncate">
          📍 {initialLocation.address}{initialLocation.district ? ` (${initialLocation.district})` : ""}
        </p>
      </div>
      <span
        id="mini-map-category-badge"
        class="inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold shrink-0"
        style={`background-color: ${initialLocation.categoryHex}; color: #ffffff;`}
      >
        {initialLocation.categoryLabel}
      </span>
    </div>

    <div class="flex items-center gap-2 pt-1">
      <a
        id="mini-map-big-link"
        href={`/map/?clinic=${initialLocation.clinicId}&lat=${initialLocation.lat}&lng=${initialLocation.lng}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg bg-brand-50 hover:bg-brand-100 text-brand-700 text-xs font-semibold border border-brand-200 transition-colors"
      >
        <span>🗺️ На большой карте ↗</span>
      </a>
      <a
        id="mini-map-route-link"
        href={`https://www.google.com/maps/dir/?api=1&destination=${initialLocation.lat},${initialLocation.lng}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors"
      >
        <span>Маршрут ↗</span>
      </a>
    </div>
  </div>
</div>

<script
  id="doctor-mini-map-data"
  type="application/json"
  set:html={JSON.stringify(locations)}
/>

<script is:inline src="/vendor/leaflet/leaflet.js"></script>

<script is:inline>
  (function () {
    let miniMap = null;
    let currentMarker = null;
    let locations = [];

    function initMiniMap() {
      const dataEl = document.getElementById("doctor-mini-map-data");
      const mapContainer = document.getElementById("doctor-mini-leaflet-map");
      if (!dataEl || !mapContainer || typeof L === "undefined") return;

      try {
        locations = JSON.parse(dataEl.textContent || "[]");
      } catch (e) {
        console.error("Failed to parse doctor locations data", e);
        return;
      }

      if (locations.length === 0) return;

      const loc = locations[0];

      miniMap = L.map("doctor-mini-leaflet-map", {
        center: [loc.lat, loc.lng],
        zoom: 15,
        scrollWheelZoom: false,
        zoomControl: true,
      });

      if (miniMap.attributionControl) {
        miniMap.attributionControl.setPrefix(
          '<a href="https://leafletjs.com" target="_blank" rel="noopener noreferrer">Leaflet</a>'
        );
      }

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>',
        maxZoom: 19,
      }).addTo(miniMap);

      renderMarker(loc);
      setupTabListeners();
    }

    function createMarkerIcon(hexColor) {
      const html = `
        <div class="relative flex items-center justify-center cursor-pointer" style="width:34px; height:42px;">
          <svg class="drop-shadow-md w-full h-full" viewBox="0 0 36 44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 0C8.06 0 0 8.06 0 18C0 29.5 18 44 18 44C18 44 36 29.5 36 18C36 8.06 27.94 0 18 0Z" fill="${hexColor}"/>
            <circle cx="18" cy="17" r="13" fill="${hexColor}" stroke="#ffffff" stroke-width="2"/>
            <circle cx="18" cy="17" r="5" fill="#ffffff"/>
          </svg>
        </div>
      `;
      return L.divIcon({
        className: "custom-doctor-marker",
        html: html,
        iconSize: [34, 42],
        iconAnchor: [17, 42],
        popupAnchor: [0, -40],
      });
    }

    function renderMarker(loc) {
      if (currentMarker && miniMap) {
        miniMap.removeLayer(currentMarker);
      }

      const icon = createMarkerIcon(loc.categoryHex || "#2563eb");
      currentMarker = L.marker([loc.lat, loc.lng], { icon: icon }).addTo(miniMap);

      const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`;
      currentMarker.bindPopup(`
        <div class="p-1 text-slate-800 text-xs">
          <strong>${loc.clinicName}</strong><br/>
          <span class="text-slate-500">${loc.address}</span>
          <div class="mt-2">
            <a href="${routeUrl}" target="_blank" rel="noopener noreferrer" class="text-brand-700 font-bold hover:underline">
              Маршрут в Google Maps ↗
            </a>
          </div>
        </div>
      `);
    }

    function updateCardUi(loc) {
      const nameEl = document.getElementById("mini-map-clinic-name");
      const addrEl = document.getElementById("mini-map-address");
      const badgeEl = document.getElementById("mini-map-category-badge");
      const bigLink = document.getElementById("mini-map-big-link");
      const routeLink = document.getElementById("mini-map-route-link");

      if (nameEl) nameEl.textContent = loc.clinicName;
      if (addrEl) addrEl.textContent = `📍 ${loc.address}${loc.district ? ` (${loc.district})` : ""}`;
      if (badgeEl) {
        badgeEl.textContent = loc.categoryLabel;
        badgeEl.style.backgroundColor = loc.categoryHex || "#2563eb";
      }
      if (bigLink) {
        bigLink.setAttribute(
          "href",
          `/map/?clinic=${loc.clinicId}&lat=${loc.lat}&lng=${loc.lng}`
        );
      }
      if (routeLink) {
        routeLink.setAttribute(
          "href",
          `https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`
        );
      }
    }

    function setupTabListeners() {
      const tabButtons = document.querySelectorAll(".btn-mini-map-tab");
      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
          if (isNaN(idx) || !locations[idx]) return;

          const loc = locations[idx];

          tabButtons.forEach((b) => {
            if (b === btn) {
              b.classList.remove("bg-slate-100", "text-slate-600");
              b.classList.add("bg-brand-600", "text-white", "shadow-xs");
            } else {
              b.classList.remove("bg-brand-600", "text-white", "shadow-xs");
              b.classList.add("bg-slate-100", "text-slate-600");
            }
          });

          renderMarker(loc);
          miniMap.setView([loc.lat, loc.lng], 15, { animate: true });
          updateCardUi(loc);
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMiniMap);
    } else {
      initMiniMap();
    }
  })();
</script>

<style is:global>
  .custom-doctor-marker {
    background: transparent !important;
    border: none !important;
  }
</style>
