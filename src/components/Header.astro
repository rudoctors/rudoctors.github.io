---
import { SITE } from "../lib/site";

const nav = [
  { href: "/doctors/", label: "Врачи" },
  { href: "/specialties/", label: "Специальности" },
  { href: "/cities/", label: "Города" },
  { href: "/about/", label: "О проекте" },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 backdrop-blur bg-white/90 border-b border-slate-200">
  <div class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-extrabold text-lg tracking-tight">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white text-sm">R</span>
      <span>Rudoctors</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-3 py-2 rounded-lg text-sm font-medium",
              path.startsWith(item.href)
                ? "text-brand-700 bg-brand-50"
                : "text-slate-600 hover:text-slate-900 hover:bg-slate-100",
            ]}
          >
            {item.href === "/about/" ? item.label : item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/doctors/" class="btn-primary hidden sm:inline-flex">Найти врача</a>
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
        title="Чат «Медицина в Сербии»"
      >
        TG
      </a>
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden btn-ghost px-2"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        ☰
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-slate-200 bg-white">
    <div class="px-4 py-3 flex flex-col gap-1">
      {
        nav.map((item) => (
          <a href={item.href} class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-50">
            {item.label}
          </a>
        ))
      }
      <a href="/doctors/" class="btn-primary mt-1">Найти врача</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    btn.setAttribute("aria-label", open ? "Закрыть меню" : "Открыть меню");
  });
</script>
