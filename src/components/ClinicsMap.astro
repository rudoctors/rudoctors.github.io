---
import {
  getMapClinicPoints,
  CLINIC_CATEGORY_META,
  getBelgradeDistricts,
} from "../lib/clinics";
import type { ClinicCategory } from "../lib/types";

interface Props {
  initialCity?: string;
  initialCategory?: ClinicCategory;
}

const { initialCity, initialCategory } = Astro.props;

const allPoints = getMapClinicPoints();
const belgradeDistricts = getBelgradeDistricts();

const cities = ["Все города", "Белград", "Нови-Сад", "Ниш"];

const categoryKeys: ClinicCategory[] = [
  "medical-center",
  "dom-zdravlja",
  "hospital",
  "dental",
  "laboratory",
  "ordination",
];

// Stats
const totalLocations = allPoints.length;
const totalDoctors = allPoints.reduce((acc, p) => acc + p.doctorsCount, 0);
const emergencyCount = allPoints.filter((p) => p.is24h).length;
---

<div class="clinics-map-root w-full my-6">
  <!-- Stylesheets for Leaflet and MarkerCluster -->
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
  <link rel="stylesheet" href="/vendor/leaflet/MarkerCluster.css" />
  <link rel="stylesheet" href="/vendor/leaflet/MarkerCluster.Default.css" />

  <!-- Top Filter and Stats Bar -->
  <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-sm mb-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-100">
      <!-- Search Input -->
      <div class="relative flex-1 max-w-lg">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </span>
        <input
          type="text"
          id="map-search-input"
          placeholder="Поиск по клинике, адресу, району или врачу..."
          class="input pl-10 pr-10 text-sm w-full"
          autocomplete="off"
        />
        <button
          type="button"
          id="map-search-clear"
          class="hidden absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600"
          title="Очистить"
        >
          ✕
        </button>
      </div>

      <!-- Quick Metrics Chips -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 font-medium">
          <span class="w-2 h-2 rounded-full bg-brand-600"></span>
          <strong id="counter-locations">{totalLocations}</strong> филиалов
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-800 font-medium border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>{totalDoctors} врачей на карте</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-50 text-rose-800 font-medium border border-rose-200">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          <span>{emergencyCount} стационара 24/7</span>
        </span>
      </div>
    </div>

    <!-- Filters Row: City & Belgrade District -->
    <div class="pt-4 flex flex-wrap items-center gap-3">
      <!-- Cities selector -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 max-w-full">
        <span class="text-xs font-semibold text-slate-500 mr-1 uppercase tracking-wider">Город:</span>
        {
          cities.map((c) => (
            <button
              type="button"
              class:list={[
                "btn-city-filter px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer",
                (initialCity === c || (!initialCity && c === "Все города"))
                  ? "bg-brand-600 text-white shadow-xs"
                  : "bg-slate-100 text-slate-700 hover:bg-slate-200",
              ]}
              data-city={c}
            >
              {c}
            </button>
          ))
        }
      </div>

      <!-- Belgrade district filter (visible when Belgrade or All cities selected) -->
      <div id="district-filter-container" class="flex items-center gap-2">
        <label for="district-select" class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
          Район:
        </label>
        <select
          id="district-select"
          class="text-xs bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
          <option value="">Все районы Белграда</option>
          {belgradeDistricts.map((d) => (
            <option value={d}>{d}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Categories Row (Colored Badges) -->
    <div class="pt-3 flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-slate-500 mr-1 uppercase tracking-wider">Тип:</span>
      <button
        type="button"
        class:list={[
          "btn-category-filter px-3 py-1.5 rounded-full text-xs font-semibold transition-all border cursor-pointer",
          !initialCategory
            ? "bg-slate-800 text-white border-slate-800 shadow-xs"
            : "bg-white text-slate-700 border-slate-200 hover:bg-slate-50",
        ]}
        data-category="all"
      >
        Все категории
      </button>

      {
        categoryKeys.map((catKey) => {
          const meta = CLINIC_CATEGORY_META[catKey];
          const isSelected = initialCategory === catKey;
          return (
            <button
              type="button"
              class:list={[
                "btn-category-filter px-3 py-1.5 rounded-full text-xs font-medium transition-all border flex items-center gap-1.5 cursor-pointer",
                isSelected
                  ? `${meta.bgClass} ${meta.textClass} ${meta.borderClass} ring-2 ring-offset-1 ring-brand-500 font-semibold shadow-xs`
                  : "bg-white text-slate-700 border-slate-200 hover:bg-slate-50",
              ]}
              data-category={catKey}
            >
              <span
                class="w-2.5 h-2.5 rounded-full inline-block"
                style={`background-color: ${meta.hex};`}
              ></span>
              <span>{meta.pluralLabel}</span>
            </button>
          );
        })
      }
    </div>
  </div>

  <!-- Mobile View Toggle (Map vs List) -->
  <div class="flex lg:hidden items-center justify-center p-1 bg-slate-100 rounded-xl mb-4 text-xs font-semibold">
    <button
      type="button"
      id="btn-toggle-map"
      class="flex-1 py-2 text-center rounded-lg bg-white text-brand-700 shadow-xs"
    >
      🗺️ Карта
    </button>
    <button
      type="button"
      id="btn-toggle-list"
      class="flex-1 py-2 text-center rounded-lg text-slate-600 hover:text-slate-900"
    >
      📋 Списком (<span id="counter-mobile-list">{totalLocations}</span>)
    </button>
  </div>

  <!-- Split View: Map + Scrollable Clinic Sidebar -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Map Container (60% / 7 cols) -->
    <div
      id="map-col"
      class="lg:col-span-7 w-full h-[520px] sm:h-[620px] lg:h-[700px] rounded-2xl overflow-hidden border border-slate-200 shadow-sm relative sticky top-20"
    >
      <div id="clinics-leaflet-map" class="w-full h-full z-10"></div>
      <!-- Map loading overlay -->
      <div
        id="map-loading"
        class="absolute inset-0 bg-white/80 backdrop-blur-xs flex items-center justify-center z-20 pointer-events-none transition-opacity duration-300"
      >
        <div class="flex items-center gap-3 px-4 py-2 bg-white rounded-xl shadow-md border border-slate-200 text-sm font-medium text-slate-700">
          <span class="w-4 h-4 border-2 border-brand-600 border-t-transparent rounded-full animate-spin"></span>
          Загрузка карты клиник...
        </div>
      </div>
    </div>

    <!-- Sidebar List of Clinics (40% / 5 cols) -->
    <div
      id="list-col"
      class="lg:col-span-5 flex flex-col gap-3 max-h-[700px] overflow-y-auto pr-1 sm:pr-2"
    >
      <div id="clinics-sidebar-list" class="space-y-3">
        <!-- Clinic cards will be dynamically rendered or updated here -->
      </div>
      <div
        id="clinics-empty-state"
        class="hidden py-12 px-6 text-center bg-white rounded-2xl border border-dashed border-slate-300"
      >
        <span class="text-3xl block mb-2">🔍</span>
        <h4 class="text-base font-bold text-slate-800">Клиники не найдены</h4>
        <p class="text-xs text-slate-500 mt-1">
          Попробуйте сбросить фильтры по городу, району или изменить поисковый запрос.
        </p>
        <button
          type="button"
          id="btn-reset-filters"
          class="btn-secondary text-xs mt-4"
        >
          Сбросить все фильтры
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Embedded Map Data for Client Script -->
<script
  id="clinics-map-data"
  type="application/json"
  set:html={JSON.stringify(allPoints)}
/>

<!-- Scripts for Leaflet and Interactive Map Logic -->
<script is:inline src="/vendor/leaflet/leaflet.js"></script>
<script is:inline src="/vendor/leaflet/leaflet.markercluster.js"></script>

<script is:inline>
  (function () {
    let map = null;
    let clusterGroup = null;
    let markersMap = new Map();
    let allPoints = [];

    let currentCity = "Все города";
    let currentDistrict = "";
    let currentCategory = "all";
    let searchQuery = "";

    const CATEGORY_COLORS = {
      "medical-center": "#2563eb",
      "dom-zdravlja": "#0891b2",
      hospital: "#dc2626",
      dental: "#16a34a",
      laboratory: "#ea580c",
      ordination: "#9333ea",
    };

    const CATEGORY_LABELS = {
      "medical-center": "Медцентр",
      "dom-zdravlja": "Дом здравља",
      hospital: "Стационар 24/7",
      dental: "Стоматология",
      laboratory: "Лаборатория 24/7",
      ordination: "Ординация",
    };

    function initMapData() {
      const dataEl = document.getElementById("clinics-map-data");
      if (!dataEl) return;
      try {
        allPoints = JSON.parse(dataEl.textContent || "[]");
      } catch (e) {
        console.error("Failed to parse clinics map data", e);
        allPoints = [];
      }
    }

    function createMarkerIcon(point) {
      const color = CATEGORY_COLORS[point.category] || "#2563eb";
      const isHospital = point.category === "hospital" || point.is24h;
      const size = isHospital ? 40 : 32;
      const iconSize = isHospital ? [size, size + 8] : [size, size + 6];

      // Custom SVG Marker Pin
      let symbolSvg = "";
      if (point.category === "dental") {
        symbolSvg = '<path d="M12 4C9 4 7 5.5 7 8c0 1.8.8 3.2 1.5 5l.8 4c.4 1.2 1.4 1.5 2.5.7.8-.5.8-1.5 1.2-2.3.4.8.4 1.8 1.2 2.3 1.1.8 2.1.5 2.5-.7l.8-4c.7-1.8 1.5-3.2 1.5-5 0-2.5-2-4-5-4z" fill="#fff"/>';
      } else if (point.category === "laboratory") {
        symbolSvg = '<path d="M9 3v4.5L5.5 14A2 2 0 0 0 7 17h10a2 2 0 0 0 1.5-3L15 7.5V3H9z" fill="#fff"/>';
      } else if (point.category === "hospital") {
        symbolSvg = '<rect x="10" y="5" width="4" height="14" fill="#fff" rx="1"/><rect x="5" y="10" width="14" height="4" fill="#fff" rx="1"/>';
      } else if (point.category === "dom-zdravlja") {
        symbolSvg = '<path d="M3 21h18M4 21V9l8-6 8 6v12h-6v-7h-4v7H4zM9 9h2v2H9V9zm4 0h2v2h-2V9zm-4 4h2v2H9v-2zm4 0h2v2h-2v-2z" fill="#fff"/>';
      } else {
        // Medical center / ordination cross
        symbolSvg = '<path d="M10 6h4v4h4v4h-4v4h-4v-4H6v-4h4V6z" fill="#fff"/>';
      }

      const pulseHtml = isHospital
        ? `<span class="absolute -inset-1 rounded-full bg-rose-500/30 animate-ping"></span>`
        : "";

      const html = `
        <div class="relative flex items-center justify-center cursor-pointer transition-transform duration-200 hover:scale-115" style="width:${size}px; height:${size}px;">
          ${pulseHtml}
          <svg class="drop-shadow-md w-full h-full" viewBox="0 0 36 44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 0C8.06 0 0 8.06 0 18C0 29.5 18 44 18 44C18 44 36 29.5 36 18C36 8.06 27.94 0 18 0Z" fill="${color}"/>
            <circle cx="18" cy="17" r="13" fill="${color}" stroke="#ffffff" stroke-width="2"/>
            <g transform="translate(6, 5) scale(0.65)">
              ${symbolSvg}
            </g>
          </svg>
        </div>
      `;

      return L.divIcon({
        className: "custom-clinic-marker",
        html: html,
        iconSize: iconSize,
        iconAnchor: [iconSize[0] / 2, iconSize[1]],
        popupAnchor: [0, -iconSize[1] + 6],
      });
    }

    function createPopupContent(point) {
      const color = CATEGORY_COLORS[point.category] || "#2563eb";
      const catLabel = CATEGORY_LABELS[point.category] || "Клиника";
      const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${point.lat},${point.lng}`;

      const emergencyBadge = point.is24h
        ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-300">🚨 24/7 Экстренная помощь</span>`
        : "";

      let doctorsHtml = "";
      if (point.doctors && point.doctors.length > 0) {
        const docList = point.doctors
          .slice(0, 3)
          .map(
            (d) => `
            <a href="/doctors/${d.slug}/" class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-slate-50 transition-colors group">
              <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-xs font-bold shrink-0 overflow-hidden">
                ${
                  d.photo
                    ? `<img src="${d.photo}" alt="${d.name}" class="w-full h-full object-cover" />`
                    : `<span>${d.name[0] || "Д"}</span>`
                }
              </div>
              <div class="min-w-0 flex-1">
                <div class="text-xs font-semibold text-slate-800 group-hover:text-brand-600 truncate">${d.name}</div>
                <div class="text-[11px] text-slate-500 truncate">${d.specializationText || "Врач"}</div>
              </div>
              ${
                d.ratingAverage > 0
                  ? `<div class="text-[11px] font-bold text-amber-600 flex items-center gap-0.5 shrink-0">★ ${d.ratingAverage.toFixed(1)}</div>`
                  : ""
              }
            </a>
          `
          )
          .join("");

        const moreDocs =
          point.doctors.length > 3
            ? `<div class="text-[11px] text-brand-600 font-medium pt-1 text-center">+ ещё ${point.doctors.length - 3} врачей каталога</div>`
            : "";

        doctorsHtml = `
          <div class="mt-3 pt-3 border-t border-slate-100">
            <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 flex items-center justify-between">
              <span>Врачи каталога RuDoctors</span>
              <span class="px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 font-semibold">${point.doctors.length}</span>
            </div>
            <div class="space-y-1">
              ${docList}
            </div>
            ${moreDocs}
          </div>
        `;
      }

      const phoneBtn = point.phone
        ? `<a href="tel:${point.phone}" class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs">
            📞 Позвонить
          </a>`
        : "";

      const webBtn = point.website
        ? `<a href="${point.website}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium">
            Сайт ↗
          </a>`
        : "";

      const domZdravljaNotice = point.category === "dom-zdravlja"
        ? `<div class="mt-2.5 text-[11px] bg-cyan-50 border border-cyan-200 text-cyan-950 rounded-lg p-2 leading-relaxed">
            🏛️ <strong>Районная поликлиника:</strong> Прикрепление по белому картону или страховке RFZO (без страховки платно через кассу), участковый врач (izabrani lekar), педиатрия и дежурная служба в выходные.
           </div>`
        : "";

      return `
        <div class="clinic-popup p-1 text-slate-800 min-w-[260px] max-w-[320px]">
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold text-white" style="background-color:${color}">
              ${catLabel}
            </span>
            ${emergencyBadge}
          </div>

          <h3 class="text-sm font-bold text-slate-900 leading-snug mt-1">${point.name}</h3>
          
          <div class="mt-1.5 text-xs text-slate-600 flex items-start gap-1">
            <span class="shrink-0 text-slate-400">📍</span>
            <span>${point.address}${point.district ? ` (${point.district})` : ""}</span>
          </div>

          ${domZdravljaNotice}

          <div class="mt-3 flex items-center gap-2 flex-wrap">
            <a href="${routeUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold shadow-xs">
              Маршрут ↗
            </a>
            ${phoneBtn}
            ${webBtn}
          </div>

          ${doctorsHtml}
        </div>
      `;
    }

    function renderSidebarList(points) {
      const container = document.getElementById("clinics-sidebar-list");
      const emptyState = document.getElementById("clinics-empty-state");
      const counterEl = document.getElementById("counter-locations");
      const mobileCounter = document.getElementById("counter-mobile-list");

      if (counterEl) counterEl.textContent = String(points.length);
      if (mobileCounter) mobileCounter.textContent = String(points.length);

      if (!container) return;

      if (points.length === 0) {
        container.innerHTML = "";
        if (emptyState) emptyState.classList.remove("hidden");
        return;
      }

      if (emptyState) emptyState.classList.add("hidden");

      container.innerHTML = points
        .map((p) => {
          const color = CATEGORY_COLORS[p.category] || "#2563eb";
          const catLabel = CATEGORY_LABELS[p.category] || "Клиника";
          const emergencyBadge = p.is24h
            ? `<span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">24/7</span>`
            : "";

          const doctorsBadge =
            p.doctorsCount > 0
              ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 text-[11px] font-semibold border border-emerald-200">
                  👨‍⚕️ ${p.doctorsCount} ${p.doctorsCount === 1 ? "врач" : p.doctorsCount < 5 ? "врача" : "врачей"}
                </span>`
              : "";

          return `
            <div
              class="clinic-card-item p-4 rounded-xl border border-slate-200 bg-white hover:border-brand-500 hover:shadow-md transition-all cursor-pointer"
              data-id="${p.id}"
            >
              <div class="flex items-start justify-between gap-2">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold text-white" style="background-color:${color}">
                    ${catLabel}
                  </span>
                  ${emergencyBadge}
                </div>
                ${doctorsBadge}
              </div>

              <h4 class="text-sm font-bold text-slate-900 mt-2 leading-snug">${p.name}</h4>
              <p class="text-xs text-slate-600 mt-1 flex items-start gap-1">
                <span class="text-slate-400 shrink-0">📍</span>
                <span>${p.address}${p.district ? ` • <strong class="text-slate-700">${p.district}</strong>` : ""}</span>
              </p>

              <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-brand-600 font-semibold flex items-center gap-1">
                  Показать на карте →
                </span>
                ${
                  p.phone
                    ? `<span class="text-slate-500 font-mono text-[11px]">${p.phone}</span>`
                    : ""
                }
              </div>
            </div>
          `;
        })
        .join("");

      // Bind click handlers to sidebar cards
      container.querySelectorAll(".clinic-card-item").forEach((card) => {
        card.addEventListener("click", () => {
          const id = card.getAttribute("data-id");
          if (!id) return;
          focusMarker(id);
        });
      });
    }

    function focusMarker(id) {
      const marker = markersMap.get(id);
      if (!marker || !map) return;

      const latLng = marker.getLatLng();
      if (clusterGroup && clusterGroup.hasLayer(marker)) {
        clusterGroup.zoomToShowLayer(marker, () => {
          map.setView(latLng, 16, { animate: true });
          marker.openPopup();
        });
      } else {
        map.setView(latLng, 16, { animate: true });
        marker.openPopup();
      }

      // Highlight card in sidebar
      document.querySelectorAll(".clinic-card-item").forEach((c) => {
        if (c.getAttribute("data-id") === id) {
          c.classList.add("ring-2", "ring-brand-500", "bg-brand-50/30");
          c.scrollIntoView({ behavior: "smooth", block: "nearest" });
        } else {
          c.classList.remove("ring-2", "ring-brand-500", "bg-brand-50/30");
        }
      });
    }

    function filterPoints() {
      const q = searchQuery.toLowerCase().trim();

      return allPoints.filter((point) => {
        // City match
        if (currentCity !== "Все города") {
          const pointCity = point.cityRu || point.city;
          if (pointCity.toLowerCase() !== currentCity.toLowerCase()) {
            return false;
          }
        }

        // Belgrade District match
        if (currentDistrict && currentDistrict.trim() !== "") {
          const ptDist = (point.district || "").toLowerCase();
          if (!ptDist.includes(currentDistrict.toLowerCase())) {
            return false;
          }
        }

        // Category match
        if (currentCategory !== "all") {
          if (point.category !== currentCategory) {
            return false;
          }
        }

        // Text Search match
        if (q) {
          const inName = point.name.toLowerCase().includes(q);
          const inAddr = point.address.toLowerCase().includes(q);
          const inDist = (point.district || "").toLowerCase().includes(q);
          const inCity = (point.cityRu || "").toLowerCase().includes(q);
          const inDocs = (point.doctors || []).some(
            (d) =>
              d.name.toLowerCase().includes(q) ||
              (d.specializationText || "").toLowerCase().includes(q)
          );
          if (!inName && !inAddr && !inDist && !inCity && !inDocs) {
            return false;
          }
        }

        return true;
      });
    }

    function updateMapAndList(shouldFitBounds) {
      if (!map || !clusterGroup) return;

      clusterGroup.clearLayers();
      markersMap.clear();

      const filtered = filterPoints();

      filtered.forEach((point) => {
        const marker = L.marker([point.lat, point.lng], {
          icon: createMarkerIcon(point),
        });

        marker.bindPopup(createPopupContent(point), {
          maxWidth: 320,
          className: "custom-leaflet-popup",
        });

        marker.on("click", () => {
          document.querySelectorAll(".clinic-card-item").forEach((c) => {
            if (c.getAttribute("data-id") === point.id) {
              c.classList.add("ring-2", "ring-brand-500", "bg-brand-50/30");
              c.scrollIntoView({ behavior: "smooth", block: "nearest" });
            } else {
              c.classList.remove("ring-2", "ring-brand-500", "bg-brand-50/30");
            }
          });
        });

        markersMap.set(point.id, marker);
        clusterGroup.addLayer(marker);
      });

      renderSidebarList(filtered);

      if (shouldFitBounds && filtered.length > 0) {
        const bounds = L.latLngBounds(filtered.map((p) => [p.lat, p.lng]));
        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
      }
    }

    function initLeaflet() {
      const container = document.getElementById("clinics-leaflet-map");
      const loadingOverlay = document.getElementById("map-loading");
      if (!container || typeof L === "undefined") return;

      // Center on Belgrade by default
      const defaultCenter = [44.8125, 20.4612];
      const defaultZoom = 13;

      map = L.map("clinics-leaflet-map", {
        center: defaultCenter,
        zoom: defaultZoom,
        scrollWheelZoom: true,
      });

      if (map.attributionControl) {
        map.attributionControl.setPrefix(
          '<a href="https://leafletjs.com" target="_blank" rel="noopener noreferrer">Leaflet</a>'
        );
      }

      // Standard OpenStreetMap tiles
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      // MarkerCluster group
      clusterGroup = L.markerClusterGroup({
        showCoverageOnHover: false,
        maxClusterRadius: 40,
        spiderfyOnMaxZoom: true,
      });

      map.addLayer(clusterGroup);

      // Hide loading
      if (loadingOverlay) {
        loadingOverlay.style.opacity = "0";
        setTimeout(() => loadingOverlay.remove(), 300);
      }

      updateMapAndList(false);
    }

    function setupEventListeners() {
      // City buttons
      document.querySelectorAll(".btn-city-filter").forEach((btn) => {
        btn.addEventListener("click", () => {
          const city = btn.getAttribute("data-city") || "Все города";
          currentCity = city;

          document.querySelectorAll(".btn-city-filter").forEach((b) => {
            if (b === btn) {
              b.classList.remove("bg-slate-100", "text-slate-700");
              b.classList.add("bg-brand-600", "text-white", "shadow-xs");
            } else {
              b.classList.remove("bg-brand-600", "text-white", "shadow-xs");
              b.classList.add("bg-slate-100", "text-slate-700");
            }
          });

          // Toggle Belgrade district container
          const distContainer = document.getElementById("district-filter-container");
          if (distContainer) {
            if (city === "Нови-Сад" || city === "Ниш") {
              distContainer.classList.add("hidden");
              currentDistrict = "";
              const distSelect = document.getElementById("district-select");
              if (distSelect) distSelect.value = "";
            } else {
              distContainer.classList.remove("hidden");
            }
          }

          updateMapAndList(true);
        });
      });

      // District select
      const distSelect = document.getElementById("district-select");
      if (distSelect) {
        distSelect.addEventListener("change", (e) => {
          currentDistrict = e.target.value;
          updateMapAndList(true);
        });
      }

      // Category buttons
      document.querySelectorAll(".btn-category-filter").forEach((btn) => {
        btn.addEventListener("click", () => {
          const cat = btn.getAttribute("data-category") || "all";
          currentCategory = cat;

          document.querySelectorAll(".btn-category-filter").forEach((b) => {
            const bCat = b.getAttribute("data-category");
            if (bCat === cat) {
              b.classList.add("ring-2", "ring-offset-1", "ring-brand-500", "font-semibold", "shadow-xs");
              if (cat === "all") {
                b.classList.add("bg-slate-800", "text-white");
                b.classList.remove("bg-white", "text-slate-700");
              }
            } else {
              b.classList.remove("ring-2", "ring-offset-1", "ring-brand-500", "font-semibold", "shadow-xs");
              if (bCat === "all") {
                b.classList.remove("bg-slate-800", "text-white");
                b.classList.add("bg-white", "text-slate-700");
              }
            }
          });

          updateMapAndList(false);
        });
      });

      // Search input
      const searchInput = document.getElementById("map-search-input");
      const searchClear = document.getElementById("map-search-clear");

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = e.target.value;
          if (searchClear) {
            if (searchQuery) searchClear.classList.remove("hidden");
            else searchClear.classList.add("hidden");
          }
          updateMapAndList(false);
        });
      }

      if (searchClear && searchInput) {
        searchClear.addEventListener("click", () => {
          searchInput.value = "";
          searchQuery = "";
          searchClear.classList.add("hidden");
          updateMapAndList(false);
        });
      }

      // Reset filters button
      const resetBtn = document.getElementById("btn-reset-filters");
      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          currentCity = "Все города";
          currentDistrict = "";
          currentCategory = "all";
          searchQuery = "";
          if (searchInput) searchInput.value = "";
          if (searchClear) searchClear.classList.add("hidden");
          if (distSelect) distSelect.value = "";

          // Reset UI buttons
          document.querySelectorAll(".btn-city-filter").forEach((b) => {
            if (b.getAttribute("data-city") === "Все города") {
              b.classList.add("bg-brand-600", "text-white");
              b.classList.remove("bg-slate-100", "text-slate-700");
            } else {
              b.classList.remove("bg-brand-600", "text-white");
              b.classList.add("bg-slate-100", "text-slate-700");
            }
          });

          document.querySelectorAll(".btn-category-filter").forEach((b) => {
            if (b.getAttribute("data-category") === "all") {
              b.classList.add("bg-slate-800", "text-white");
            } else {
              b.classList.remove("ring-2", "ring-brand-500", "font-semibold");
            }
          });

          updateMapAndList(true);
        });
      }

      // Mobile Toggle: Map vs List
      const btnToggleMap = document.getElementById("btn-toggle-map");
      const btnToggleList = document.getElementById("btn-toggle-list");
      const mapCol = document.getElementById("map-col");
      const listCol = document.getElementById("list-col");

      if (btnToggleMap && btnToggleList && mapCol && listCol) {
        btnToggleMap.addEventListener("click", () => {
          mapCol.classList.remove("hidden");
          listCol.classList.add("hidden");
          btnToggleMap.classList.add("bg-white", "text-brand-700", "shadow-xs");
          btnToggleMap.classList.remove("text-slate-600");
          btnToggleList.classList.remove("bg-white", "text-brand-700", "shadow-xs");
          btnToggleList.classList.add("text-slate-600");
          if (map) map.invalidateSize();
        });

        btnToggleList.addEventListener("click", () => {
          mapCol.classList.add("hidden");
          listCol.classList.remove("hidden");
          btnToggleList.classList.add("bg-white", "text-brand-700", "shadow-xs");
          btnToggleList.classList.remove("text-slate-600");
          btnToggleMap.classList.remove("bg-white", "text-brand-700", "shadow-xs");
          btnToggleMap.classList.add("text-slate-600");
        });
      }
    }

    function init() {
      initMapData();
      initLeaflet();
      setupEventListeners();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

