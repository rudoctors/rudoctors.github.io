# Telegram-модерация заявок «Добавить врача» (npm run tg:bot)
# Скопируйте в site/.env (не коммитится) и заполните. Инструкция: docs/TELEGRAM-BOT.md

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш chat_id (напишите боту /start — он подскажет значение)
TELEGRAM_ADMIN_CHAT_ID=

# Fine-grained PAT: Contents (Read and write) + Issues (Read and write) на rudoctors/rudoctors.github.io
GITHUB_TOKEN=

# Репозиторий каталога (можно не менять)
GITHUB_REPO=rudoctors/rudoctors.github.io
